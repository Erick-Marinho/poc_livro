---
/**
 * Um terminal do livro (ilha React: terminal/TerminalAoVivo.tsx), guiado ou interativo.
 * Hidrata quando o navegador fica livre (client:idle): são vários por capítulo e leves.
 * A saída vem do saidas.json do livro, gravado a partir do código real pelo scripts/saidas.py.
 * Formato de uma saída: { "comando": "...", "saida": [["linha", "classe"], ...] }
 * ou, com variantes: { "comando": "...", "variantes": { "antes": [...], "depois": [...] } }.
 */
import TerminalAoVivo from "./terminal/TerminalAoVivo";
import type { Saida } from "./terminal/TerminalAoVivo";
interface Props { saida: Saida; pasta?: string; rotulos?: Record<string, string> }
const { saida, pasta = "~/projeto", rotulos = {} } = Astro.props;
if (!saida || !saida.comando || !(saida.saida || saida.variantes)) throw new Error("Terminal: saída sem comando ou sem linhas; confira o saidas.json");
---
<TerminalAoVivo client:idle saida={saida} pasta={pasta} rotulos={rotulos} />
