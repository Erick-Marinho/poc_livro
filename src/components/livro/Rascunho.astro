---
/**
 * O lugar de uma ação do leitor sugerida pela skill `revisar-ritmo`, escrito no próprio texto
 * (docs/capacidades/ritmo-no-texto.md). O responsável troca pelo componente de verdade, ou apaga. O texto de dentro é
 * a sugestão do conteúdo. A regra do que ele precisa dizer está em `conferirRascunho`, no relógio.
 */
import { conferirRascunho } from "../../../scripts/ritmo.mjs";

interface Props { acao: string; frase: string; verbo: string; dado: string; nova?: boolean }
const { acao, frase, verbo, dado, nova = false } = Astro.props;
conferirRascunho({ acao, nova, dado });
---
<aside class="rascunho" data-rascunho={acao}>
  <p class="ras-rotulo">ação sugerida · {acao}{nova && " (componente novo)"}</p>
  <p class="ras-frase">“{frase}”</p>
  <dl class="ras-dados"><dt>verbo</dt><dd>{verbo}</dd><dt>dado</dt><dd>{dado}</dd></dl>
  <div class="ras-sugestao"><slot /></div>
  <p class="ras-nota">Troque pelo componente, ou apague: texto com rascunho não publica.</p>
</aside>

<style is:global>
  .rascunho { margin: 1.4em auto 1.8em; border: 2px solid var(--aviso); border-radius: 12px; background: var(--nota); padding: 14px 16px; font: 15px/1.55 var(--f-ui) }
  .ras-rotulo { margin: 0 0 6px; font: 600 11px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--aviso) }
  .ras-frase { margin: 0 0 8px; font: italic 16px/1.45 var(--f-texto) }
  .ras-dados { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2px 10px; margin: 0 0 8px; font-size: 13.5px }
  .ras-dados dt { font: 600 12px var(--f-mono); color: var(--ink-2) } .ras-dados dd { margin: 0 }
  .ras-sugestao { border-top: 1px solid var(--linha); padding-top: 8px }
  .ras-sugestao p { margin: 0 0 .5em } .ras-sugestao p:last-child { margin: 0 }
  .ras-nota { margin: 8px 0 0; font-size: 12.5px; color: var(--ink-2) }
</style>
