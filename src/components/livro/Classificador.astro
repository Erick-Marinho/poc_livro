---
/**
 * Figura interativa: o leitor decide o que o agente faria com cada pergunta e compara com o contrato.
 * As perguntas e as decisões vêm do referencia.jsonl real (passado como texto), escolhidas pelo id.
 */
interface Props { referencia: string; casos: string[]; numero: string; legenda: string }
const { referencia, casos, numero, legenda } = Astro.props;
type Caso = { id: string; pergunta: string; decisao: string; motivo: string };
const todos: Caso[] = referencia.split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
const escolhidos = casos.map((id) => {
  const c = todos.find((x) => x.id === id);
  if (!c) throw new Error(`Classificador: o caso ${id} não está no referencia.jsonl`);
  return c;
});
const DECISOES = [["responder", "responder"], ["abrir_chamado", "abrir chamado"], ["recusar", "recusar"], ["passar", "passar a vez"]];
---
<figure class="classificador largo" data-classificador>
  <div class="cls-quadro">
    <div class="cls-placar"><span>Você concordou com o contrato em <b data-certos>0</b> de <b data-feitos>0</b></span><button type="button" data-zerar>recomeçar</button></div>
    <ol>
      {escolhidos.map((c) => (
        <li data-caso={c.id} data-decisao={c.decisao}>
          <p class="cls-pergunta">“{c.pergunta}”</p>
          <div class="cls-botoes">{DECISOES.map(([v, t]) => <button type="button" data-v={v}>{t}</button>)}</div>
          <p class="cls-resposta" hidden><span class="cls-veredito"></span> O contrato diz: <b>{DECISOES.find((d) => d[0] === c.decisao)![1]}</b>, porque {c.motivo}.</p>
        </li>
      ))}
    </ol>
  </div>
  <figcaption><b>Figura {numero}</b> · {legenda}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-classificador]").forEach((fig) => {
    const placar = () => {
      const feitos = fig.querySelectorAll("li.feito"), certos = fig.querySelectorAll("li.certo");
      fig.querySelector("[data-feitos]")!.textContent = String(feitos.length);
      fig.querySelector("[data-certos]")!.textContent = String(certos.length);
    };
    fig.querySelectorAll<HTMLLIElement>("li[data-caso]").forEach((li) => {
      li.querySelectorAll<HTMLButtonElement>("[data-v]").forEach((b) => b.addEventListener("click", () => {
        if (li.classList.contains("feito")) return;
        const certo = b.dataset.v === li.dataset.decisao;
        li.classList.add("feito", certo ? "certo" : "errado");
        li.querySelectorAll<HTMLButtonElement>("[data-v]").forEach((x) => {
          x.disabled = true;
          if (x.dataset.v === li.dataset.decisao) x.classList.add("e-o-contrato");
          if (x === b) x.classList.add("escolhido");
        });
        li.querySelector(".cls-veredito")!.textContent = certo ? "Igual ao contrato." : "Diferente do contrato.";
        (li.querySelector(".cls-resposta") as HTMLElement).hidden = false;
        placar();
      }));
    });
    fig.querySelector("[data-zerar]")!.addEventListener("click", () => {
      fig.querySelectorAll("li").forEach((li) => {
        li.classList.remove("feito", "certo", "errado");
        (li.querySelector(".cls-resposta") as HTMLElement).hidden = true;
        li.querySelectorAll<HTMLButtonElement>("[data-v]").forEach((x) => { x.disabled = false; x.classList.remove("e-o-contrato", "escolhido"); });
      });
      placar();
    });
  });
</script>

<style is:global>
  .classificador { margin: 1.8em auto 2em }
  .cls-quadro { background: var(--papel-2); border: 1px solid var(--linha); border-radius: 12px; padding: 14px 16px }
  .cls-placar { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; font: 14px var(--f-ui); color: var(--ink-2); margin-bottom: 10px }
  .cls-placar b { color: var(--ink) }
  .cls-placar button { border: 1px solid var(--linha); background: var(--papel); border-radius: 6px; padding: 3px 10px; cursor: pointer; font: 13px var(--f-ui) }
  .classificador ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px }
  .classificador li { background: var(--papel); border: 1px solid var(--linha); border-radius: 10px; padding: 12px 14px; font: 15px/1.5 var(--f-ui) }
  .classificador li.certo { border-color: var(--ok) }
  .classificador li.errado { border-color: var(--aviso) }
  .cls-pergunta { margin: 0 0 8px; font: italic 17px/1.5 var(--f-texto) }
  .cls-botoes { display: flex; flex-wrap: wrap; gap: 6px }
  .cls-botoes button { border: 1px solid var(--linha); background: var(--papel-2); border-radius: 999px; padding: 4px 12px; cursor: pointer; font: 500 13.5px var(--f-ui) }
  .cls-botoes button:not(:disabled):hover { border-color: var(--acento) }
  .cls-botoes button:disabled { cursor: default; opacity: .55 }
  .cls-botoes button.e-o-contrato { opacity: 1; border-color: var(--ok); color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent) }
  .cls-botoes button.escolhido:not(.e-o-contrato) { opacity: 1; border-color: var(--aviso); color: var(--aviso) }
  .cls-resposta { margin: 8px 0 0; font-size: 14.5px; color: var(--ink-2) }
  .cls-veredito { font-weight: 600; color: var(--ink) }
  .classificador figcaption { font: 14px/1.5 var(--f-ui); color: var(--ink-2); margin-top: 10px }
  .classificador figcaption b { color: var(--ink); font-weight: 600 }
</style>
