---
/**
 * O mapa da temperatura zero (docs/capacidades/temperatura-zero-revisao.md, etapa 2): o vídeo temperatura/MapaTemperatura.tsx,
 * que o leitor toca ou rola. Os números são a saída gravada de figuras/mapa.py (tz-mapa), conferida no build
 * (temperatura/mapa.ts). Sem JS, os balões em lista, com o comando que calculou os valores.
 */
import MapaTemperatura from "./temperatura/MapaTemperatura";
import { baloes, montarMapa } from "./temperatura/mapa";
type Saida = { comando: string; saida: [string, string][] };
const { saidas } = Astro.props as { saidas: Record<string, Saida> };
const fonte = saidas["tz-mapa"];
if (!fonte) throw new Error("MapaTemperatura: falta a saída tz-mapa");
const bruto = fonte.saida.find(([l]) => l.startsWith("{"))?.[0];
if (!bruto) throw new Error("MapaTemperatura: falta o rastro JSON do exemplo");
const dados = montarMapa(bruto);
---
<figure class="tz-figura" data-tz-mapa aria-label="A mesma pergunta, duas ordens de soma, as pontuações e a escolha do próximo token">
  <MapaTemperatura client:visible={{ rootMargin: "400px" }} bruto={bruto} />
  <noscript><ol>{baloes(dados).map((b) => <li>{b.texto}</li>)}</ol></noscript>
  <figcaption><b>Figura 1</b> · A mesma pergunta, sozinha ou num grupo, e o que muda até a escolha. Ilustração numérica, não pontuações de um modelo de linguagem: os valores são calculados por <code>{fonte.comando}</code>, a partir de <code>numeros.py</code>.</figcaption>
</figure>
<style>
  .tz-figura { margin: 1.8em auto 2em; max-width: 800px }
  figcaption { font: 14px/1.5 var(--f-ui); color: var(--ink-2); margin-top: 10px }
</style>
