---
/**
 * O passador: um trecho do arquivo real, lido bloco lógico por bloco lógico.
 * O bloco atual acende e o resto apaga; embaixo, o que o bloco faz, em palavras do dia a dia, e as palavras do código
 * que podem travar quem está começando (do glossário do livro). Alguns blocos terminam numa pergunta curta.
 * O leitor avança (botões, setas do teclado, ou clicando numa linha) e volta quando quiser.
 * No build: o trecho cabe no arquivo, todo bloco cai dentro do trecho, os blocos não se cruzam, todo termo existe no
 * glossário e toda pergunta tem a resposta certa entre as opções. No modo direto, todos os blocos aparecem abertos.
 */
import { Code } from "astro:components";
import type { ShikiTransformer } from "shiki";

type Pergunta = { texto: string; opcoes: string[]; certa: number; porque: string };
type Bloco = { linhas: string; titulo: string; texto: string; termos?: string[]; pergunta?: Pergunta };
type Termo = { marca?: string; rotulo?: string; texto: string };
interface Props {
  codigo: string;
  dados: { arquivo: string; linhas: string; blocos: Bloco[] };
  glossario: { termos: Record<string, Termo> };
  numero: string;
  legenda: string;
}
const { codigo, dados, glossario, numero, legenda } = Astro.props;
const falhar = (m: string): never => { throw new Error(`Passador (figura ${numero}, ${dados.arquivo}): ${m}`); };
const faixa = (s: string): [number, number] => {
  const m = s.match(/^(\d+)(?:-(\d+))?$/) ?? falhar(`"${s}" não é uma faixa de linhas`);
  return [Number(m[1]), Number(m[2] ?? m[1])];
};

const todas = codigo.replace(/\n$/, "").split("\n");
const [de, ate] = faixa(dados.linhas);
if (de < 1 || ate > todas.length || de > ate) falhar(`trecho ${dados.linhas} fora do arquivo (${todas.length} linhas)`);
const blocos = dados.blocos.map((b, i) => {
  const [a, z] = faixa(b.linhas);
  if (a < de || z > ate || a > z) falhar(`bloco ${i + 1} (${b.linhas}) fora do trecho ${dados.linhas}`);
  for (const t of b.termos ?? []) if (!glossario.termos[t]) falhar(`bloco ${i + 1}: "${t}" não está no glossário`);
  if (b.pergunta && !(b.pergunta.certa >= 0 && b.pergunta.certa < b.pergunta.opcoes.length)) falhar(`bloco ${i + 1}: a resposta certa não está entre as opções`);
  return { ...b, a, z };
});
blocos.forEach((b, i) => { if (i > 0 && b.a <= blocos[i - 1].z) falhar(`os blocos ${i} e ${i + 1} se cruzam`); });

/* cada linha sabe de que bloco é; a palavra do glossário que aparece sozinha num pedaço do código fica sublinhada */
const blocoDa = (n: number) => blocos.findIndex((b) => n >= b.a && n <= b.z);
const marcas = new Map(Object.entries(glossario.termos).filter(([, t]) => t.marca).map(([k, t]) => [t.marca!, k]));
const marcar: ShikiTransformer = {
  code(no) { no.children = no.children.filter((c) => c.type === "element"); },
  line(no, i) {
    const n = de + i - 1, b = blocoDa(n);
    no.properties["data-n"] = String(n);
    if (b >= 0) no.properties["data-bloco"] = String(b);
  },
  span(no, linha) {
    const b = blocoDa(de + linha - 1);
    if (b < 0) return;
    const texto = no.children.map((c) => (c.type === "text" ? c.value : "")).join("");
    const termo = marcas.get(texto.trim());
    if (termo && blocos[b].termos?.includes(termo)) { this.addClassToHast(no, "termo"); no.properties["data-termo"] = termo; return; }
    /* o realce às vezes junta a palavra com o que está em volta (" = Field("): aí ela vira um pedaço só dela */
    for (const [marca, k] of marcas) {
      if (!blocos[b].termos?.includes(k)) continue;
      const m = new RegExp(`(^|[^\\w])(${marca.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})(?![\\w])`).exec(texto);
      if (!m) continue;
      const i = m.index + m[1].length;
      no.children = [
        { type: "text", value: texto.slice(0, i) },
        { type: "element", tagName: "span", properties: { class: "termo", "data-termo": k }, children: [{ type: "text", value: marca }] },
        { type: "text", value: texto.slice(i + marca.length) },
      ];
      return;
    }
  },
};
const rotuloDe = (k: string) => glossario.termos[k].rotulo ?? k;
---
<figure class="passador largo" data-passador>
  <div class="pd-quadro">
    <div class="pd-codigo">
      <div class="pd-aba"><span class="pd-ic">PY</span>{dados.arquivo}<span class="pd-info">linhas {de} a {ate}</span></div>
      <Code code={todas.slice(de - 1, ate).join("\n")} lang="python" theme="dark-plus" transformers={[marcar]} />
    </div>
    <div class="pd-painel">
      {blocos.map((b, i) => (
        <section class="pd-bloco" data-i={i} hidden={i > 0}>
          <p class="pd-onde">bloco {i + 1} de {blocos.length} · linhas {b.a === b.z ? b.a : `${b.a} a ${b.z}`} · <b>{b.titulo}</b></p>
          <p class="pd-texto">{b.texto}</p>
          {b.termos && b.termos.length > 0 && (
            <div class="pd-termos">
              <span class="pd-rot">palavras deste bloco</span>
              {b.termos.map((t) => <button type="button" class="pd-chip" data-chip={t} aria-expanded="false"><code>{rotuloDe(t)}</code></button>)}
              {b.termos.map((t) => <p class="pd-def" data-def={t} hidden><code>{rotuloDe(t)}</code> {glossario.termos[t].texto}</p>)}
            </div>
          )}
          {b.pergunta && (
            <div class="pd-pergunta" data-certa={b.pergunta.certa}>
              <p><b>◆ antes de seguir:</b> {b.pergunta.texto}</p>
              <div class="pd-opcoes">{b.pergunta.opcoes.map((o, j) => <button type="button" data-op={j}>{o}</button>)}</div>
              <p class="pd-porque" hidden><span class="pd-veredito"></span> {b.pergunta.porque}</p>
            </div>
          )}
        </section>
      ))}
      <div class="pd-controles">
        <button type="button" data-ant aria-label="Bloco anterior">←</button>
        <span class="pd-pontos">{blocos.map((b, i) => <button type="button" data-ir={i} aria-label={`Bloco ${i + 1}: ${b.titulo}`} />)}</span>
        <button type="button" data-prox>próximo bloco →</button>
      </div>
    </div>
  </div>
  <figcaption><b>Figura {numero}</b> · {legenda}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-passador]").forEach((fig) => {
    const secoes = [...fig.querySelectorAll<HTMLElement>(".pd-bloco")];
    const linhas = [...fig.querySelectorAll<HTMLElement>(".line")];
    let atual = 0;
    const ir = (i: number) => {
      atual = Math.max(0, Math.min(secoes.length - 1, i));
      secoes.forEach((s, k) => (s.hidden = k !== atual && !document.documentElement.hasAttribute("data-direto")));
      linhas.forEach((l) => l.classList.toggle("acesa", l.dataset.bloco === String(atual)));
      fig.querySelectorAll<HTMLButtonElement>("[data-ir]").forEach((b, k) => b.setAttribute("aria-current", String(k === atual)));
      (fig.querySelector("[data-ant]") as HTMLButtonElement).disabled = atual === 0;
      (fig.querySelector("[data-prox]") as HTMLButtonElement).disabled = atual === secoes.length - 1;
    };
    fig.querySelector("[data-ant]")!.addEventListener("click", () => ir(atual - 1));
    fig.querySelector("[data-prox]")!.addEventListener("click", () => ir(atual + 1));
    fig.querySelectorAll<HTMLButtonElement>("[data-ir]").forEach((b) => b.addEventListener("click", () => ir(Number(b.dataset.ir))));
    linhas.forEach((l) => l.addEventListener("click", () => { if (l.dataset.bloco) ir(Number(l.dataset.bloco)); }));
    fig.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest(".pd-opcoes")) return;
      if (e.key === "ArrowRight") { ir(atual + 1); e.preventDefault(); }
      if (e.key === "ArrowLeft") { ir(atual - 1); e.preventDefault(); }
    });

    /* a palavra: o chip abre a explicação no painel; a palavra sublinhada no código abre a mesma explicação */
    const abrirTermo = (sec: HTMLElement, t: string) => {
      sec.querySelectorAll<HTMLElement>("[data-def]").forEach((d) => (d.hidden = d.dataset.def !== t || !d.hidden));
      sec.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((c) => c.setAttribute("aria-expanded", String(c.dataset.chip === t && !sec.querySelector<HTMLElement>(`[data-def="${CSS.escape(t)}"]`)!.hidden)));
    };
    secoes.forEach((sec) => sec.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((c) => c.addEventListener("click", () => abrirTermo(sec, c.dataset.chip!))));
    fig.querySelectorAll<HTMLElement>(".termo").forEach((el) => el.addEventListener("click", (e) => {
      e.stopPropagation();
      const b = Number(el.closest<HTMLElement>(".line")!.dataset.bloco); ir(b);
      const sec = secoes[b], d = sec.querySelector<HTMLElement>(`[data-def="${CSS.escape(el.dataset.termo!)}"]`)!;
      if (d.hidden) abrirTermo(sec, el.dataset.termo!);
    }));

    /* a pergunta: uma tentativa, depois o porquê */
    fig.querySelectorAll<HTMLElement>(".pd-pergunta").forEach((q) => q.querySelectorAll<HTMLButtonElement>("[data-op]").forEach((b) => b.addEventListener("click", () => {
      const certo = b.dataset.op === q.dataset.certa;
      q.querySelectorAll<HTMLButtonElement>("[data-op]").forEach((x) => { x.disabled = true; if (x.dataset.op === q.dataset.certa) x.classList.add("e-a-certa"); if (x === b) x.classList.add("escolhida"); });
      q.classList.add(certo ? "certo" : "errado");
      q.querySelector(".pd-veredito")!.textContent = certo ? "Isso." : "Não é essa.";
      (q.querySelector(".pd-porque") as HTMLElement).hidden = false;
    })));
    addEventListener("fontmar:direto", () => ir(atual));
    ir(0);
  });
</script>

<style is:global>
  .passador { margin: 1.8em auto 2em }
  .pd-quadro { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); border-radius: 12px; overflow: hidden; border: 1px solid var(--linha); background: var(--papel-2) }
  .pd-codigo { background: var(--ide-bg); color: var(--ide-ink); min-width: 0 }
  .pd-aba { display: flex; align-items: center; gap: 8px; background: var(--ide-tabs); font: 12.5px var(--f-ui); color: #ddd; padding: 7px 14px }
  .pd-ic { font: 700 8.5px var(--f-mono); color: #4b9cd3 }
  .pd-info { margin-left: auto; color: #8b8b8b; font-size: 11.5px }
  .passador pre.astro-code { margin: 0; padding: 10px 0 12px; overflow-x: auto; font: 13.5px/22px var(--f-mono); background: var(--ide-bg) !important }
  .passador pre.astro-code code { display: block; min-width: max-content; background: none; padding: 0; font-size: inherit; border-radius: 0 }
  .passador .line { display: block; min-height: 22px; white-space: pre; padding-right: 16px; opacity: .4; transition: opacity .2s, background .2s; border-left: 3px solid transparent }
  .passador .line[data-bloco] { cursor: pointer }
  .passador .line::before { content: attr(data-n); display: inline-block; width: 40px; padding-right: 14px; text-align: right; color: #6e7681; user-select: none }
  .passador .line.acesa { opacity: 1; background: var(--ide-new); border-left-color: #3794ff }
  .passador .termo { text-decoration: underline dotted 1.5px; text-underline-offset: 4px; cursor: help }
  .pd-painel { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; font: 15px/1.55 var(--f-ui); min-width: 0 }
  .pd-bloco { display: grid; gap: 8px }
  .pd-bloco[hidden], .pd-def[hidden], .pd-porque[hidden] { display: none }
  .pd-onde { margin: 0; font: 12px/1.5 var(--f-mono); color: var(--ink-2) }
  .pd-onde b { font-family: var(--f-ui); font-size: 13px; color: var(--acento) }
  .pd-texto { margin: 0; font: 16.5px/1.55 var(--f-texto) }
  .pd-termos { display: flex; flex-wrap: wrap; gap: 6px; align-items: center }
  .pd-rot { width: 100%; font: 600 10.5px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2) }
  .pd-chip { border: 1px solid var(--linha); background: var(--papel); border-radius: 999px; padding: 2px 10px; cursor: pointer }
  .pd-chip code { background: none; padding: 0; font-size: 13px }
  .pd-chip[aria-expanded="true"] { border-color: var(--acento); box-shadow: inset 0 0 0 1px var(--acento) }
  .pd-def { width: 100%; margin: 2px 0 0; padding: 8px 10px; background: var(--papel); border-left: 3px solid var(--acento); border-radius: 0 6px 6px 0; font-size: 14.5px }
  .pd-def code { font-weight: 600 }
  .pd-pergunta { border-top: 1px dashed var(--linha); padding-top: 8px; display: grid; gap: 6px }
  .pd-pergunta p { margin: 0 }
  .pd-pergunta > p > b { color: var(--aviso); font-weight: 600 }
  .pd-opcoes { display: flex; flex-wrap: wrap; gap: 6px }
  .pd-opcoes button { border: 1px solid var(--linha); background: var(--papel); border-radius: 6px; padding: 3px 12px; cursor: pointer; font: 500 14px var(--f-mono) }
  .pd-opcoes button:disabled { cursor: default; opacity: .55 }
  .pd-opcoes button.e-a-certa { opacity: 1; border-color: var(--ok); color: var(--ok) }
  .pd-opcoes button.escolhida:not(.e-a-certa) { opacity: 1; border-color: var(--aviso); color: var(--aviso) }
  .pd-veredito { font-weight: 600 }
  .pd-pergunta.certo .pd-veredito { color: var(--ok) }
  .pd-pergunta.errado .pd-veredito { color: var(--aviso) }
  .pd-controles { margin-top: auto; display: flex; align-items: center; gap: 8px; padding-top: 6px }
  .pd-controles > button { border: 1px solid var(--linha); background: var(--papel); border-radius: 6px; padding: 4px 12px; cursor: pointer; font: 500 13.5px var(--f-ui) }
  .pd-controles [data-prox] { border-color: var(--acento); color: var(--acento); margin-left: auto }
  .pd-controles button:disabled { opacity: .4; cursor: default }
  .pd-pontos { display: flex; gap: 5px }
  .pd-pontos button { width: 9px; height: 9px; padding: 0; border-radius: 50%; border: 0; background: var(--linha); cursor: pointer }
  .pd-pontos button[aria-current="true"] { background: var(--acento) }
  .passador figcaption { font: 14px/1.5 var(--f-ui); color: var(--ink-2); margin-top: 10px }
  .passador figcaption b { color: var(--ink); font-weight: 600 }
  /* modo direto: todos os blocos abertos, sem apagar o código e sem os controles */
  html[data-direto] .passador .line { opacity: 1 }
  html[data-direto] .passador .line.acesa { background: none; border-left-color: transparent }
  html[data-direto] .pd-controles, html[data-direto] .pd-pergunta { display: none }
  html[data-direto] .pd-bloco + .pd-bloco { border-top: 1px solid var(--linha); padding-top: 10px }
  @media (max-width: 820px) { .pd-quadro { grid-template-columns: 1fr } }
</style>
