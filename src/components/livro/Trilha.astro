---
/**
 * A trilha do capítulo: todos os passos de construção num fluxo só, para o leitor ver de onde sai e aonde chega.
 * Cada passo é um botão que leva até ele; o sinal diz o que o comando do fim mostra (vem da saída gravada):
 * ✓ dá certo, ✗ dá erro de propósito, ! dá certo e esconde um erro (o `engano` do passo), • não roda nada.
 * O passo fica marcado quando o leitor chega ao "agora você tem" dele (evento fontmar:passo-feito, do Passo).
 */
type DefPasso = { id: string; secao: string; titulo: string; curta: string; de: number; ate: number; engano?: string };
interface Props {
  capitulo: { passos: DefPasso[] };
  roteiro: { passos: { acao: string; id?: string }[] };
  saidas: Record<string, { saiu_com: number; saida: [string, string][] }>;
  secoes: Record<string, string>;
  numero: string;
  legenda: string;
}
const { capitulo, roteiro, saidas, secoes, numero, legenda } = Astro.props;
const sinal = (p: DefPasso) => {
  const runs = roteiro.passos.slice(p.de - 1, p.ate).filter((x) => x.acao === "rodar");
  if (!runs.length) return { s: "•", c: "nada", t: "não roda nada" };
  if (p.engano) return { s: "!", c: "engano", t: p.engano };
  const ultimo = saidas[runs.at(-1)!.id!] ?? (() => { throw new Error(`Trilha: a saída ${runs.at(-1)!.id} não está no saidas.json`); })();
  /* erro de propósito: saiu com código de erro, ou mostrou uma linha de erro (o `| tail -1` sai com 0) */
  const errou = ultimo.saiu_com !== 0 || ultimo.saida.some(([, c]) => c === "err");
  return !errou ? { s: "✓", c: "ok", t: "dá certo" } : { s: "✗", c: "erro", t: "dá erro, de propósito" };
};
const grupos = [...new Set(capitulo.passos.map((p) => p.secao))].map((secao) => {
  if (!secoes[secao]) throw new Error(`Trilha: falta o nome da seção ${secao}`);
  return { secao, nome: secoes[secao], passos: capitulo.passos.map((p, i) => ({ ...p, n: i + 1, ...sinal(p) })).filter((p) => p.secao === secao) };
});
---
<figure class="trilha largo" data-trilha>
  <div class="tr-quadro">
    {grupos.map((g, gi) => (
      <div class="tr-grupo">
        <p class="tr-secao"><span>{g.secao}</span> {g.nome}</p>
        <ol class="tr-passos">
          {g.passos.map((p) => (
            <li>
              <a href={`#passo-${p.id}`} data-ir-passo={p.id} title={`${p.titulo}: ${p.t}`}>
                <span class="tr-num">{p.n}</span><span class="tr-nome">{p.curta}</span><span class:list={["tr-sinal", p.c]} aria-label={p.t}>{p.s}</span>
              </a>
            </li>
          ))}
        </ol>
        {gi < grupos.length - 1 && <span class="tr-desce" aria-hidden="true">↓</span>}
      </div>
    ))}
    <p class="tr-legenda"><span class="tr-sinal ok">✓</span> dá certo <span class="tr-sinal erro">✗</span> dá erro de propósito <span class="tr-sinal engano">!</span> dá certo e esconde um erro <span class="tr-sinal nada">•</span> não roda nada · <span data-feitos>0</span> de {capitulo.passos.length} feitos</p>
  </div>
  <figcaption><b>Figura {numero}</b> · {legenda}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-trilha]").forEach((fig) => {
    const feitos = new Set<string>();
    addEventListener("fontmar:passo-feito", (e) => {
      const id = (e as CustomEvent<string>).detail;
      feitos.add(id);
      fig.querySelector(`[data-ir-passo="${CSS.escape(id)}"]`)?.classList.add("feito");
      fig.querySelector("[data-feitos]")!.textContent = String(feitos.size);
    });
    /* o passo na tela fica aceso na trilha */
    const links = new Map([...fig.querySelectorAll<HTMLElement>("[data-ir-passo]")].map((a) => [a.dataset.irPasso!, a]));
    const obs = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.remove("atual"));
      links.get((e.target as HTMLElement).dataset.passoId!)?.classList.add("atual");
    }), { rootMargin: "-40% 0px -55% 0px" });
    document.querySelectorAll<HTMLElement>("[data-passo-id]").forEach((p) => obs.observe(p));
  });
</script>

<style is:global>
  .trilha { margin: 1.6em auto 2em }
  .tr-quadro { border: 1px solid var(--linha); border-radius: 12px; background: var(--papel-2); padding: 14px 16px; display: grid; gap: 4px }
  .tr-grupo { display: grid; gap: 6px }
  .tr-secao { margin: 0; font: 600 13px var(--f-ui); color: var(--ink) }
  .tr-secao span { font: 600 12px var(--f-mono); color: var(--acento); margin-right: 4px }
  .tr-passos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 0; align-items: center }
  .tr-passos li { display: flex; align-items: center }
  .tr-passos li + li::before { content: "→"; color: var(--ink-2); margin: 0 6px; font: 13px var(--f-ui) }
  .tr-passos a { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--linha); background: var(--papel); border-radius: 999px; padding: 3px 10px 3px 4px; text-decoration: none; color: var(--ink); font: 13.5px/1.3 var(--f-ui) }
  .tr-passos a:hover { border-color: var(--acento) }
  .tr-passos a.atual { border-color: var(--acento); box-shadow: inset 0 0 0 1px var(--acento) }
  .tr-passos a.feito { background: color-mix(in srgb, var(--ok) 12%, var(--papel)) }
  .tr-num { display: inline-grid; place-items: center; min-width: 20px; height: 20px; border-radius: 50%; background: var(--papel-2); font: 600 11px var(--f-mono); color: var(--ink-2) }
  .tr-passos a.feito .tr-num { background: var(--ok); color: var(--papel) }
  .tr-sinal { font: 700 12px var(--f-mono) }
  .tr-sinal.ok { color: var(--ok) } .tr-sinal.erro { color: #c0392b } .tr-sinal.engano { color: var(--aviso) } .tr-sinal.nada { color: var(--ink-2) }
  .tr-desce { justify-self: start; margin-left: 12px; color: var(--ink-2); font: 14px var(--f-ui) }
  .tr-legenda { margin: 8px 0 0; padding-top: 8px; border-top: 1px dashed var(--linha); font: 12.5px/1.8 var(--f-ui); color: var(--ink-2) }
  .tr-legenda .tr-sinal { margin-left: 8px }
  .tr-legenda .tr-sinal:first-child { margin-left: 0 }
  .trilha figcaption { font: 14px/1.5 var(--f-ui); color: var(--ink-2); margin-top: 10px }
  .trilha figcaption b { color: var(--ink); font-weight: 600 }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .tr-sinal.erro { color: #ff7b6b } }
  :root[data-theme="dark"] .tr-sinal.erro { color: #ff7b6b }
</style>
