---
import Comandos from "./comandos/Comandos";
/**
 * A navegação do livro: o sumário à esquerda e, embaixo, os comandos fixos (ilha React: comandos/Comandos.tsx).
 * O sumário mostra o livro inteiro, inclusive o que ainda não foi escrito, para o leitor ver onde está no caminho.
 * A partir de 1280 px ele fica aberto ao lado do texto; abaixo disso vira gaveta, aberta pelo botão da pílula.
 */
export type ItemSumario = { numero?: number; titulo: string; href?: string; atual: boolean };
export type Marco = { capitulo: number; rotulo: string; quem: string; acertos: number; total: number; nota: string; comando: string; revelaCom?: string };
export type Placar = { marcos: Marco[]; proximo?: { capitulo: number; pergunta: string } };
type Vizinho = { href: string; rotulo: string };
interface Props {
  livro: string;
  onde: string;
  itens: ItemSumario[];
  secoes: { id: string; texto: string }[];
  anterior?: Vizinho;
  proximo?: Vizinho;
  emBreve?: string;
  placar?: Placar;
}
const { livro, onde, itens, secoes, anterior, proximo, emBreve, placar } = Astro.props;
---
<aside id="sumario" class="sumario" aria-label="Sumário do livro" data-sumario>
  <div class="sm-topo">
    <a class="sm-marca" href="/" aria-label="FontMar, início">Font<span>Mar</span></a>
    <button type="button" class="sm-fechar" data-fechar aria-label="Fechar o sumário">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>
  <p class="sm-livro">{livro}</p>
  <ol class="sm-lista">
    {itens.map((it) => (
      <li class:list={["sm-item", { atual: it.atual, "em-breve": !it.href }]}>
        {it.href
          ? <a href={it.href} aria-current={it.atual ? "page" : undefined}>{it.numero && <span class="sm-num">{it.numero}</span>}<span>{it.titulo}</span></a>
          : <span class="sm-sem-link">{it.numero && <span class="sm-num">{it.numero}</span>}<span>{it.titulo}</span><small>em breve</small></span>}
        {it.atual && secoes.length > 0 && (
          <ol class="sm-secoes">
            {secoes.map((s) => <li><a href={`#${s.id}`} data-secao={s.id}>{s.texto}</a></li>)}
          </ol>
        )}
      </li>
    ))}
  </ol>
</aside>
<div class="sm-veu" data-veu hidden></div>

<Comandos client:load livro={livro} onde={onde} anterior={anterior} proximo={proximo} emBreve={emBreve} placar={placar} />

<script>
  const aside = document.querySelector<HTMLElement>("[data-sumario]")!;
  const veu = document.querySelector<HTMLElement>("[data-veu]")!;
  /* o botão de abrir mora na pílula, que é uma ilha e pode ser recriada: por isso a delegação */
  const botoes = () => document.querySelectorAll<HTMLButtonElement>("[data-abrir]");
  const focarBotao = () => botoes()[0]?.focus();
  const gaveta = matchMedia("(max-width: 1279px)");
  const definir = (aberto: boolean) => {
    document.documentElement.classList.toggle("sumario-aberto", aberto);
    botoes().forEach((b) => b.setAttribute("aria-expanded", String(aberto)));
    veu.hidden = !aberto;
    if (aberto) (aside.querySelector<HTMLElement>("[aria-current]") ?? aside.querySelector<HTMLElement>("a"))?.focus();
  };
  document.addEventListener("click", (e) => {
    if ((e.target as Element).closest?.("[data-abrir]")) definir(!document.documentElement.classList.contains("sumario-aberto"));
  });
  aside.querySelector("[data-fechar]")!.addEventListener("click", () => { definir(false); focarBotao(); });
  veu.addEventListener("click", () => definir(false));
  addEventListener("keydown", (e) => { if (e.key === "Escape" && document.documentElement.classList.contains("sumario-aberto")) { definir(false); focarBotao(); } });
  /* na gaveta, escolher uma seção fecha o sumário */
  aside.querySelectorAll("[data-secao]").forEach((a) => a.addEventListener("click", () => gaveta.matches && definir(false)));
  gaveta.addEventListener("change", () => definir(false));

  /* a seção em que o leitor está acende no sumário; --lido (0 a 1) diz quanto do texto já foi, para a pílula e o círculo */
  const links = [...aside.querySelectorAll<HTMLAnchorElement>("[data-secao]")];
  const ver = () => {
    const h = document.documentElement, max = h.scrollHeight - h.clientHeight;
    h.style.setProperty("--lido", String(max > 0 ? h.scrollTop / max : 0));
    let atual: string | undefined;
    for (const a of links) { const el = document.getElementById(a.dataset.secao!); if (el && el.getBoundingClientRect().top < 140) atual = a.dataset.secao; }
    links.forEach((a) => a.classList.toggle("aqui", a.dataset.secao === atual));
  };
  addEventListener("scroll", ver, { passive: true }); ver();

  /* modo direto (palco/direto.ts): as respostas do "pare e pense" ficam abertas */
  const abrirRespostas = () => {
    const direto = document.documentElement.hasAttribute("data-direto");
    document.querySelectorAll<HTMLDetailsElement>(".pense details").forEach((d) => { d.open = direto; });
  };
  addEventListener("fontmar:direto", abrirRespostas);
  if (document.documentElement.hasAttribute("data-direto")) abrirRespostas();
</script>

<style is:global>
  :root { --sumario: 0px }
  @media (min-width: 1280px) { :root { --sumario: 280px } body { padding-left: var(--sumario) } }

  .sumario { position: fixed; inset: 0 auto 0 0; width: 280px; z-index: 30; display: flex; flex-direction: column; gap: 4px;
    background: var(--papel); border-right: 1px solid var(--linha); padding: 14px 14px 110px; overflow-y: auto; font: 14px/1.4 var(--f-ui); box-sizing: border-box }
  .sm-topo { display: flex; align-items: center; justify-content: space-between; height: 36px; margin-bottom: 10px }
  .sm-marca { font: 700 17px/1 var(--f-texto); color: var(--ink); text-decoration: none; letter-spacing: -.01em }
  .sm-marca span { color: var(--acento) }
  .sm-fechar { display: none; border: 0; background: none; color: var(--ink-2); cursor: pointer; padding: 6px; border-radius: 8px }
  .sm-livro { margin: 0 0 8px; font: 600 11px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2) }
  .sm-lista, .sm-secoes { list-style: none; margin: 0; padding: 0 }
  .sm-item > a, .sm-sem-link { display: flex; align-items: baseline; gap: 10px; padding: 7px 10px; border-radius: 8px; color: var(--ink); text-decoration: none }
  .sm-item > a:hover { background: var(--papel-2) }
  .sm-item.atual > a { background: var(--papel-2); font-weight: 600 }
  .sm-num { font: 600 12px var(--f-mono); color: var(--acento); min-width: 1.2em }
  .sm-sem-link { color: var(--ink-2); opacity: .7 }
  .sm-sem-link small { margin-left: auto; font: 10px var(--f-mono); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap }
  .sm-secoes { margin: 4px 0 8px 22px; border-left: 1px solid var(--linha) }
  .sm-secoes a { display: block; padding: 4px 10px; color: var(--ink-2); text-decoration: none; font-size: 13px; border-left: 2px solid transparent; margin-left: -1px }
  .sm-secoes a:hover { color: var(--ink) }
  .sm-secoes a.aqui { color: var(--acento); border-left-color: var(--acento) }
  .sm-veu { position: fixed; inset: 0; z-index: 29; background: rgba(20, 16, 10, .35) }

  @media (max-width: 1279px) {
    .sumario { transform: translateX(-100%); transition: transform .25s ease; box-shadow: 0 0 40px rgba(20, 16, 10, .2); visibility: hidden }
    .sumario-aberto .sumario { transform: none; visibility: visible }
    .sm-fechar { display: block }
  }
  /* com o sumário aberto ao lado, a pílula não precisa do botão dele, e a marca fica só no sumário */
  @media (min-width: 1280px) { .sm-veu { display: none } .topo .marca { display: none } .topo .nome { padding-left: 0; border-left: 0 } }
  @media (prefers-reduced-motion: reduce) { .sumario { transition: none } }

  /* modo direto: o classificador mostra o que o contrato diz, sem pedir a escolha */
  html[data-direto] .cls-resposta { display: block !important }
  html[data-direto] .cls-veredito, html[data-direto] .cls-placar { display: none }
  @media print { .sumario, .sm-veu { display: none } body { padding-left: 0 } }
</style>
