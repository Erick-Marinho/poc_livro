---
/**
 * Figura interativa: o caminho de uma pergunta, passo a passo, em jeitos diferentes de montar o sistema.
 * O leitor escolhe o jeito (abas) e a pergunta, e avança no próprio ritmo (ilha React: rastro/RastroAoVivo.tsx).
 * Os dados vêm de um JSON do livro: { perguntas: [{id, texto}], modos: [{id, nome, quem_decide, passos: {pergunta: [passo]}}] }.
 * Um passo: { quem, texto, decide?, erro?, certo? }. No build, cada caminho é conferido: começa no cliente,
 * termina numa resposta certa ou errada, e só anda por ligações que o desenho conhece.
 * Abaixo da figura vai o mesmo conteúdo em texto, para quem lê sem JS ou com leitor de tela.
 */
import RastroAoVivo, { ARESTAS_RASTRO } from "./rastro/RastroAoVivo";
import { nomeDaLoja } from "../../lib/livroDaPagina.ts";
import type { DadosRastro, PassoRastro, Quem } from "./rastro/RastroAoVivo";

type Passo = { quem: string; texto: string; decide?: boolean; erro?: string; certo?: boolean };
type Modo = { id: string; nome: string; quem_decide: string; passos: Record<string, Passo[]> };
interface Props { dados: { perguntas: { id: string; texto: string }[]; modos: Modo[] }; numero: string; legenda: string; inicio?: string }
const { dados, numero, legenda, inicio } = Astro.props;
const QUEM: Record<string, Quem> = { cliente: "cliente", "código": "codigo", modelo: "modelo", ferramenta: "ferramenta", resposta: "resposta" };
const DURACAO: Record<Quem, number> = { cliente: 1500, codigo: 2400, modelo: 2600, ferramenta: 2800, resposta: 2800 };
const CORES = ["ambar", "ciano", "verde", "lilas"];
const falhar = (onde: string, motivo: string): never => { throw new Error(`Rastro · ${onde}: ${motivo}`); };

const modos = dados.modos.map((m, k) => {
  const passos: Record<string, PassoRastro[]> = {};
  for (const p of dados.perguntas) {
    const onde = `${m.id}/${p.id}`;
    const lista = m.passos[p.id];
    if (!lista?.length) falhar(onde, "o modo não tem passos para a pergunta.");
    const convertidos = lista.map((s) => ({ ...s, quem: QUEM[s.quem] ?? falhar(onde, `quem desconhecido: "${s.quem}".`), duracao: DURACAO[QUEM[s.quem]] }));
    if (convertidos[0].quem !== "cliente") falhar(onde, "o caminho tem que começar no cliente.");
    const fim = convertidos[convertidos.length - 1];
    if (fim.quem !== "resposta" || !(fim.certo || fim.erro)) falhar(onde, "o caminho tem que terminar numa resposta marcada como certa ou com o erro.");
    convertidos.slice(1).forEach((s, i) => {
      const lig = `${convertidos[i].quem}-${s.quem}`;
      if (!ARESTAS_RASTRO.includes(lig)) falhar(onde, `o desenho não tem a ligação "${lig}".`);
    });
    passos[p.id] = convertidos;
  }
  return { id: m.id, nome: m.nome, quem_decide: m.quem_decide, cor: CORES[k % CORES.length], passos };
});
/* a pergunta curta do botão é o que o cliente diz no primeiro passo */
const perguntas = dados.perguntas.map((p) => ({ ...p, curta: dados.modos[0].passos[p.id][0].texto }));
const prontos: DadosRastro = { perguntas, modos };
const i0 = Math.max(dados.modos.findIndex((m) => m.id === inicio), 0);
---
<figure class="rastro largo">
  <RastroAoVivo client:visible={{ rootMargin: "400px" }} dados={prontos} inicio={i0} loja={nomeDaLoja(Astro.url)} />
  <figcaption><b>Figura {numero}</b> · {legenda}</figcaption>
  <details class="rastro-texto">
    <summary>A figura em texto</summary>
    {dados.modos.map((m) => (
      <section>
        <h4>{m.nome} <span>quem decide: {m.quem_decide}</span></h4>
        {dados.perguntas.map((p) => (
          <ol data-caminho={`${m.id}/${p.id}`} aria-label={`${m.nome}: ${p.texto}`}>
            {m.passos[p.id].map((s) => (
              <li><b>{s.quem}{s.decide && " (decide)"}:</b> {s.texto}{s.erro && <em> ✗ {s.erro}</em>}{s.certo && <em> ✓ veio dos dados da loja</em>}</li>
            ))}
          </ol>
        ))}
      </section>
    ))}
  </details>
</figure>

<style>
  .rastro { margin-block: 1.8em 2em; width: min(920px, 100vw - 32px); max-width: none; margin-left: calc(50% - min(460px, 50vw - 16px)) }
  figcaption { margin-top: 10px; font: 14px/1.5 var(--f-ui); color: var(--ink-2) }
  figcaption b { color: var(--ink); font-weight: 600 }
  .rastro-texto { margin-top: 8px; font: 14px/1.5 var(--f-ui); color: var(--ink-2) }
  .rastro-texto summary { cursor: pointer; width: max-content; color: var(--acento) }
  .rastro-texto h4 { margin: 1em 0 .3em; font: 600 14px var(--f-ui); color: var(--ink) }
  .rastro-texto h4 span { font-weight: 400; color: var(--ink-2); margin-left: 6px }
  .rastro-texto ol { margin: 0 0 .6em; padding-left: 22px }
  .rastro-texto em { color: var(--ink) }
</style>
