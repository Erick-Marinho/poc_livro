---
/**
 * A figura do 2.3 (docs/capacidades/capitulo-2-em-cenas.md, etapa 3): o ensaio do substituto, com um modelo de mentira, o
 * modelo falso (roteiro/FiguraEnsaio.tsx). O grafo é o real; os ensaios são os testes do test_agente.py; a saída é a
 * do pytest gravada. A montagem confere tudo no build (roteiro/ensaio.ts). Sem JS, só um aviso.
 */
import FiguraEnsaio from "./roteiro/FiguraEnsaio";
import { montarEnsaio, type Entrada } from "./roteiro/ensaio.ts";

interface Props extends Entrada { numero: string; legenda: string }
const { arestas, nos, referencia, testes, pytest, numero, legenda } = Astro.props;
montarEnsaio({ arestas, nos, referencia, testes, pytest });
---
<figure class="roteiro" data-ensaio>
  <FiguraEnsaio client:visible={{ rootMargin: "400px" }} arestas={arestas} nos={nos} referencia={referencia} testes={testes} pytest={pytest} />
  <figcaption><b>Figura {numero}</b> · {legenda}</figcaption>
  <noscript><p class="rt-semjs">Esta figura é animada e precisa de JavaScript.</p></noscript>
</figure>
