---
interface Passo { no: string; texto: string; duracao: number }
interface Props { roteiro: { caso: string; passos: Passo[] }; referencia: string }
const { roteiro, referencia } = Astro.props;
const caso = referencia.split("\n").filter((linha) => linha.trim()).map((linha) => JSON.parse(linha))
  .find((item) => item.id === roteiro.caso);
const resposta = roteiro.passos.find((passo) => passo.no === "conversa")!.texto;
const titulo = `figura-agente-${roteiro.caso}`;
---
<figure class="figura-agente largo" data-figura-agente data-roteiro={JSON.stringify(roteiro.passos)}>
  <div class="fag-quadro">
    <section class="fag-conversa" aria-label="Conversa simulada">
      <h3><span>Por fora</span> A conversa</h3>
      <div class="fag-mensagens">
        <div class="fag-mensagem fag-pergunta"><b>Bruno · cliente</b><p>{caso.pergunta}</p></div>
        <div class="fag-mensagem fag-resposta"><b>Agente</b><p>{resposta}</p></div>
      </div>
      <p class="fag-contrato">{caso.id} · decisão no contrato: <strong>{caso.decisao}</strong></p>
    </section>
    <section class="fag-interior" aria-label="Grafo do agente">
      <h3><span>Por dentro</span> O caminho da resposta</h3>
      <svg viewBox="0 0 360 395" role="img" aria-labelledby={`${titulo}-titulo ${titulo}-descricao`}>
        <title id={`${titulo}-titulo`}>Da pergunta à resposta</title>
        <desc id={`${titulo}-descricao`}>O cliente pergunta; o agente consulta pedidos, confere o e-mail e decide {caso.decisao}. Política, catálogo, abrir chamado e passar a vez são outros caminhos do agente.</desc>
        <defs><marker id={`${titulo}-seta`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" /></marker></defs>
        <rect class="fag-fundo-ferramentas" x="194" y="54" width="151" height="141" rx="12" />
        <g class="fag-arestas" marker-end={`url(#${titulo}-seta)`}>
          <path data-trajeto="cliente-agente" d="M 90 49 L 90 95" />
          <path data-trajeto="agente-pedidos" d="M 145 112 C 168 90 185 90 207 103" />
          <path data-trajeto="pedidos-agente" d="M 207 124 C 185 143 168 143 145 123" />
          <path data-trajeto="agente-decisao" d="M 90 141 L 90 217" />
          <path data-trajeto="decisao-resposta" d="M 90 253 L 90 277 L 90 347" />
          <path class="fag-alternativa" d="M 263 311 L 263 347" />
        </g>
        <g class="fag-no" data-no="cliente"><rect x="35" y="12" width="110" height="37" rx="10" /><text x="90" y="36">cliente</text></g>
        <g class="fag-no" data-no="agente"><rect x="35" y="95" width="110" height="46" rx="10" /><text x="90" y="115">agente</text><text class="fag-apoio" x="90" y="132">pensa</text></g>
        <g class="fag-ferramentas">
          <text class="fag-rotulo" x="269" y="75">ferramentas</text>
          <g class="fag-no" data-no="pedidos"><rect x="207" y="89" width="125" height="39" rx="8" /><text x="269" y="114">pedidos</text></g>
          <text class="fag-outros" x="269" y="148">política · catálogo</text>
          <text class="fag-outros" x="269" y="176">abrir chamado</text>
        </g>
        <g class="fag-no fag-decisao" data-no="decisao">
          <rect x="20" y="217" width="325" height="94" rx="12" />
          <text x="90" y="243">decisão</text>
          <rect class="fag-escolha" x="38" y="263" width="104" height="30" rx="15" />
          <text class="fag-escolha-texto" x="90" y="283">{caso.decisao}</text>
          <text class="fag-outros" x="263" y="240">abrir chamado</text>
          <text class="fag-outros" x="263" y="266">recusar</text>
          <text class="fag-outros" x="263" y="292">passar a vez</text>
        </g>
        <g class="fag-no" data-no="resposta"><rect x="35" y="347" width="110" height="37" rx="10" /><text x="90" y="371">resposta</text></g>
        <g class="fag-no fag-alternativa"><rect x="188" y="347" width="151" height="37" rx="10" /><text x="263" y="371">pessoa da equipe</text></g>
        <circle class="fag-bolinha" r="5" cx="90" cy="31" hidden />
      </svg>
      <p class="fag-andamento">Pedido consultado · e-mail conferido · resposta</p>
    </section>
  </div>
  <figcaption><b>Figura P.1</b> · Simulação do agente que você vai construir. A pergunta e a decisão vêm do contrato do capítulo 1.</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-figura-agente]").forEach((figura) => {
    const passos: { no: string; texto: string; duracao: number }[] = JSON.parse(figura.dataset.roteiro!);
    const bolinha = figura.querySelector<SVGCircleElement>(".fag-bolinha")!;
    const andamento = figura.querySelector<HTMLElement>(".fag-andamento")!;
    const nos = figura.querySelectorAll<SVGGElement>("[data-no]");
    const trajetos = [null, null, "cliente-agente", "agente-pedidos", "pedidos-agente", "agente-decisao", "decisao-resposta", null];
    figura.dataset.tempo = "pronta";
    andamento.textContent = "O atendimento começa ao chegar à figura.";

    const tocar = () => {
      let indice = 0;
      let inicio: number | undefined;
      const quadro = (agora: number) => {
        inicio ??= agora;
        let decorrido = agora - inicio;
        while (decorrido >= passos[indice].duracao && indice < passos.length - 1) {
          inicio += passos[indice].duracao;
          indice++;
          decorrido = agora - inicio;
        }
        const passo = passos[indice];
        figura.dataset.tempo = indice === 0 ? "pergunta" : indice === passos.length - 1 ? "resposta" : "grafo";
        nos.forEach((no) => no.classList.toggle("ativo", no.dataset.no === passo.no));
        andamento.textContent = passo.no === "conversa" ? "Pedido consultado · e-mail conferido · resposta" : passo.texto;
        const trajeto = trajetos[indice];
        bolinha.toggleAttribute("hidden", !trajeto && passo.no !== "cliente");
        if (trajeto) {
          const caminho = figura.querySelector<SVGPathElement>(`[data-trajeto="${trajeto}"]`)!;
          const ponto = caminho.getPointAtLength(caminho.getTotalLength() * Math.min(decorrido / (passo.duracao * .75), 1));
          bolinha.setAttribute("cx", String(ponto.x));
          bolinha.setAttribute("cy", String(ponto.y));
        }
        if (indice < passos.length - 1 || decorrido < passo.duracao) requestAnimationFrame(quadro);
        else {
          figura.dataset.tempo = "concluida";
          nos.forEach((no) => no.classList.remove("ativo"));
        }
      };
      requestAnimationFrame(quadro);
    };
    if ("IntersectionObserver" in window) {
      const observar = new IntersectionObserver((entradas) => {
        if (entradas.some((entrada) => entrada.isIntersecting)) {
          observar.disconnect();
          tocar();
        }
      }, { threshold: .2 });
      observar.observe(figura);
    } else tocar();
  });
</script>

<style>
  .figura-agente { margin-block: 1.8em 2em }
  .fag-quadro { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--linha); border-radius: 12px; background: var(--papel-2); overflow: hidden }
  .fag-conversa, .fag-interior { padding: 18px; min-width: 0 }
  .fag-interior { border-left: 1px solid var(--linha) }
  h3 { margin: 0 0 20px; font: 600 17px/1.3 var(--f-ui) }
  h3 span { display: block; margin-bottom: 4px; font: 12px var(--f-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-2) }
  .fag-mensagens { display: grid; gap: 20px; align-content: start }
  .fag-mensagem { padding: 14px; border: 1px solid var(--linha); border-radius: 12px; background: var(--papel); font: 16px/1.55 var(--f-ui); overflow-wrap: anywhere }
  .fag-mensagem b { display: block; color: var(--ink-2); margin-bottom: 7px; font-size: 12px; font-weight: 500 }
  .fag-mensagem p { margin: 0; hyphens: none }
  .fag-pergunta { margin-right: 20px }
  .fag-resposta { margin-left: 20px; border-color: var(--ok) }
  .fag-resposta b { color: var(--ok) }
  .fag-contrato { margin: 20px 0 0; font: 12px/1.5 var(--f-ui); color: var(--ink-2) }
  .fag-contrato strong { color: var(--ink); font-weight: 500 }
  svg { display: block; width: 100%; height: auto; overflow: visible; font: 16px var(--f-ui) }
  svg text { fill: var(--ink); text-anchor: middle }
  .fag-arestas path { fill: none; stroke: var(--linha); stroke-width: 2 }
  marker path { fill: var(--ink-2) }
  .fag-no > rect, .fag-fundo-ferramentas { fill: var(--papel); stroke: var(--linha); stroke-width: 1.5 }
  .fag-apoio { font-size: 12px; fill: var(--ink-2) }
  .fag-rotulo { font-size: 13px; fill: var(--ink-2) }
  .fag-outros { font-size: 14px; fill: var(--ink-2) }
  .fag-alternativa { opacity: .65 }
  .fag-no > .fag-escolha { fill: var(--papel-2); stroke: var(--ok) }
  .fag-escolha-texto { fill: var(--ok); font-size: 14px }
  .fag-no.ativo > rect { stroke: var(--acento); stroke-width: 2.5 }
  .fag-no.ativo > text:not(.fag-outros) { fill: var(--acento) }
  .fag-bolinha { fill: var(--acento); stroke: var(--papel); stroke-width: 2 }
  .fag-bolinha[hidden] { display: none }
  .fag-andamento { min-height: 3em; margin: 12px 0 0; font: 13px/1.5 var(--f-ui); color: var(--ink-2) }
  figcaption { margin-top: 10px; font: 14px/1.5 var(--f-ui); color: var(--ink-2) }
  figcaption b { color: var(--ink); font-weight: 600 }
  [data-tempo="pronta"] .fag-mensagem, [data-tempo="pergunta"] .fag-resposta, [data-tempo="grafo"] .fag-resposta { visibility: hidden }
  [data-tempo="pergunta"] .fag-pergunta, [data-tempo="resposta"] .fag-resposta { animation: fag-entra .35s ease-out both }
  @keyframes fag-entra { from { opacity: 0; transform: translateY(6px) } to { opacity: 1; transform: none } }
  @media (max-width: 639px) {
    .fag-quadro { grid-template-columns: 1fr }
    .fag-conversa, .fag-interior { padding: 14px }
    .fag-interior { border-left: 0; border-top: 1px solid var(--linha) }
    h3 { margin-bottom: 14px; font-size: 16px }
    .fag-mensagens { gap: 12px }
    .fag-mensagem { padding: 12px; font-size: 14px; line-height: 1.45 }
    .fag-contrato { margin-top: 12px }
    .fag-andamento { min-height: 3em; margin-top: 6px }
  }
</style>
