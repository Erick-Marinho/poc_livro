---
/**
 * "Você está aqui": o anel do ciclo de vida em miniatura (o mesmo desenho do mapa, ciclo/Anel.tsx), na abertura de um
 * capítulo, com a fase dele acesa, e ao lado o nome da fase, os capítulos e um link para o mapa inteiro (MapaDoCiclo,
 * na introdução). A miniatura é só desenho: o leitor de tela lê a lista das fases, com a deste capítulo marcada.
 * Vem do `figuras/ciclo.json` do livro, montado na página.
 */
import Anel, { ESTILO } from "./ciclo/Anel";

export type CicloAqui = { fases: { id: string; nome: string; capitulos: number[]; transversal?: boolean }[]; aceso: string; mapa?: string };
interface Props { ciclo: CicloAqui }
const { ciclo } = Astro.props;
const aceso = ciclo.fases.find((f) => f.id === ciclo.aceso)!;
---
<Fragment set:html={`<style>${ESTILO}</style>`} />
<nav class="aqui" aria-label="Onde este capítulo fica no ciclo de vida do agente" data-ciclo-aqui={ciclo.aceso}>
  <div class="aqui-anel"><Anel fases={ciclo.fases} desenho="anel" aceso={ciclo.aceso} prefixo="aqui" decorativo /></div>
  <div class="aqui-texto">
    <span class="aqui-rotulo">você está aqui</span>
    <b class="aqui-fase">{aceso.nome} <small>· cap. {aceso.capitulos.join(" e ")}</small></b>
    <span class="aqui-nota">{aceso.transversal ? "Vale em todas as fases. " : ""}{ciclo.mapa && <a href={ciclo.mapa}>o mapa do ciclo</a>}</span>
    <ol class="aqui-lista">
      {ciclo.fases.filter((f) => !f.transversal).map((f) => (
        <li aria-current={f.id === ciclo.aceso ? "step" : undefined}>{f.nome}</li>
      ))}
    </ol>
  </div>
</nav>

<style is:global>
  .aqui { margin: 0 auto 1.4em; display: flex; align-items: center; gap: 14px; font: 13px/1.4 var(--f-ui); color: var(--ink-2) }
  /* a miniatura: só as formas, sem texto; a fase do capítulo cheia */
  .aqui-anel { flex: none; width: 112px }
  .aqui-anel svg { display: block; width: 100%; height: auto }
  .aqui-anel .an-nome, .aqui-anel .an-cap, .aqui-anel .an-rotulo-erro, .aqui-anel .an-fundo-rotulo { display: none }
  .aqui-anel .an-caixa, .aqui-anel .an-ida, .aqui-anel .an-erro, .aqui-anel .an-evoluir, .aqui-anel .an-halo { vector-effect: non-scaling-stroke }
  /* as pontas das setas não encolhem com o desenho: na miniatura, saem */
  .aqui-anel .an-ida, .aqui-anel .an-erro, .aqui-anel .an-evoluir { marker-end: none }
  .aqui-anel .an-no { cursor: default }
  .aqui-anel .an-no.an-aceso .an-caixa { fill: var(--acento); stroke: var(--acento) }
  .aqui-texto { display: grid; gap: 1px }
  .aqui-rotulo { font: 600 11px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--acento) }
  .aqui-fase { font: 600 15px var(--f-ui); color: var(--ink) }
  .aqui-fase small { font: 12px var(--f-mono); color: var(--ink-2) }
  .aqui a { color: inherit }
  /* a lista das fases é para o leitor de tela; na tela, a miniatura faz esse papel */
  .aqui-lista { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; margin: 0; padding: 0 }
</style>
