---
/**
 * Ação do leitor: ser o gabarito (docs/capacidades/voce-e-o-gabarito.md). A mesma mensagem, três tentativas (o bilhete
 * muda, ou o modelo muda), uma por vez em cartões; o leitor corrige cada resposta: cumpriu o gabarito, ou o gabarito
 * pega. A frase muda a cada tentativa; o gabarito só olha o que foi feito. A mensagem e a decisão do gabarito vêm do
 * referencia.jsonl; os bilhetes e as respostas são ilustração, e a caixa diz. O veredito sai da comparação, não do JSON.
 * No modo direto, os vereditos aparecem todos, sem pedir a correção.
 */
import { casos, DECISOES } from "../../lib/referencia.ts";

type Variante = { bilhete: string; modelo: string; resposta: string; decisao: string; como?: string };
interface Props { referencia: string; dados: { caso: string; variantes: Variante[] }; pergunta: string; ilustracao: string }
const { referencia, dados, pergunta, ilustracao } = Astro.props;
const [caso] = casos(referencia, [dados.caso], "Troca");
dados.variantes.forEach((v) => { if (!DECISOES[v.decisao]) throw new Error(`Troca: a decisão "${v.decisao}" não é do contrato`); });
if (!dados.variantes.some((v) => v.decisao !== caso.decisao)) throw new Error("Troca: precisa de ao menos uma tentativa que o gabarito pega");
const certo = DECISOES[caso.decisao].nome;
---
<div class="tro" data-troca>
  <p class="tro-rotulo">palpite · você é o gabarito</p>
  <p class="tro-pergunta">{pergunta}</p>
  <q class="tro-msg">{caso.pergunta}</q>
  <p class="tro-gabarito">O gabarito diz: <b>{certo}</b>, porque {caso.motivo}.</p>
  {dados.variantes.map((v) => {
    const ok = v.decisao === caso.decisao;
    return (
      <div class="tro-cartao" data-certa={ok ? "0" : "1"}>
        <div class="tro-bilhete"><span>o bilhete</span>{v.bilhete}</div>
        <p class="tro-modelo">{v.modelo} responde:</p>
        <p class="tro-resposta">“{v.resposta}”</p>
        <div class="tro-opcoes"><button type="button" data-j="0" aria-pressed="false">cumpriu o gabarito</button><button type="button" data-j="1" aria-pressed="false">o gabarito pega</button></div>
        <p class:list={["tro-fez", ok ? "tro-ok" : "tro-nao"]} hidden>{ok ? `✓ Cumpriu: decidiu ${certo}, como o gabarito manda. Outra frase, a mesma decisão.` : `✗ O gabarito pega: ${v.como ?? `decidiu ${DECISOES[v.decisao].nome}`}, e ele manda ${certo}.`}</p>
      </div>
    );
  })}
  <p class="tro-placar" hidden></p>
  <p class="tro-ilustracao">{ilustracao}</p>
</div>

<script>
  import { emCartoes } from "../../lib/cartoes";

  document.querySelectorAll<HTMLElement>("[data-troca]").forEach((fig) => {
    const cartoes = [...fig.querySelectorAll<HTMLElement>(".tro-cartao")];
    emCartoes(fig, cartoes, (c) => c.classList.contains("feita"));
    const placar = fig.querySelector<HTMLElement>(".tro-placar")!;
    let feitas = 0, iguais = 0;
    cartoes.forEach((c) => c.querySelectorAll<HTMLButtonElement>(".tro-opcoes button").forEach((b) => b.addEventListener("click", () => {
      if (c.classList.contains("feita")) return;
      c.classList.add("feita");
      c.querySelectorAll<HTMLButtonElement>(".tro-opcoes button").forEach((x) => { x.disabled = true; });
      b.setAttribute("aria-pressed", "true");
      c.querySelector<HTMLElement>(".tro-fez")!.hidden = false;
      feitas++; if (b.dataset.j === c.dataset.certa) iguais++;
      if (feitas === cartoes.length) {
        placar.hidden = false;
        placar.textContent = `Você corrigiu como o gabarito em ${iguais} de ${cartoes.length}. As frases mudaram a cada tentativa; o gabarito só olhou o que foi feito.`;
      }
    })));
  });
</script>

<style is:global>
  .tro { margin: 1.6em auto 1.8em; border: 1px solid var(--linha); border-radius: 12px; background: var(--nota); padding: 16px; font: 15.5px/1.55 var(--f-ui) }
  .tro-rotulo { margin: 0 0 4px; font: 600 11px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--acento) }
  .tro-pergunta { margin: 0 0 10px; font: 600 17px/1.4 var(--f-ui) }
  .tro-msg { display: block; border: 1px solid var(--linha); border-radius: 10px; background: var(--papel); padding: 10px 13px; margin-bottom: 8px; font: italic 16px/1.45 var(--f-texto) }
  .tro-gabarito { margin: 0 0 12px; font-size: 14.5px; color: var(--ink-2) } .tro-gabarito b { color: var(--ok) }
  .tro-cartao { border: 1px solid var(--linha); border-radius: 10px; background: var(--papel); padding: 12px 13px }
  /* o bilhete como papel, como os do 2.4 */
  .tro-bilhete { display: grid; gap: 4px; padding: 10px 13px; border-radius: 4px; transform: rotate(-.6deg); font: italic 16px/1.45 var(--f-texto);
    background: color-mix(in srgb, var(--aviso) 7%, var(--papel)); border: 1px solid color-mix(in srgb, var(--aviso) 18%, var(--linha)); box-shadow: 0 3px 10px rgb(40 30 10 / .08) }
  .tro-bilhete span { font: 600 11px var(--f-ui); font-style: normal; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2) }
  @media (prefers-reduced-motion: reduce) { .tro-bilhete { transform: none } }
  .tro-modelo { margin: 12px 0 2px; font: 600 13px var(--f-ui); color: var(--ink-2) }
  .tro-resposta { margin: 0 0 10px; font: italic 16px/1.45 var(--f-texto) }
  .tro-opcoes { display: flex; flex-wrap: wrap; gap: 6px }
  .tro-opcoes button { border: 1px solid var(--linha); background: var(--papel-2); border-radius: 999px; padding: 5px 13px; cursor: pointer; font: 500 14px var(--f-ui) }
  .tro-opcoes button:not(:disabled):hover { border-color: var(--acento) }
  .tro-opcoes button:disabled { cursor: default; opacity: .6 }
  .tro-opcoes button[aria-pressed="true"] { opacity: 1; border-color: var(--acento); box-shadow: inset 0 0 0 1px var(--acento) }
  .tro-fez { margin: 10px 0 0; padding: 7px 10px; border-radius: 0 8px 8px 0; background: var(--papel-2); font-weight: 600; font-size: 14.5px }
  .tro-ok { color: var(--ok); border-left: 3px solid var(--ok) } .tro-nao { color: var(--aviso); border-left: 3px solid var(--aviso) }
  .tro-placar { margin: 6px 0 0; font-weight: 500 }
  .tro-ilustracao { margin: 10px 0 0; font-size: 13px; color: var(--ink-2) }
  /* modo direto: os vereditos de uma vez, sem pedir a correção */
  html[data-direto] .tro-fez { display: block !important }
  html[data-direto] .tro-opcoes { display: none }
</style>
