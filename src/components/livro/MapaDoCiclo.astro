---
/**
 * O mapa do ciclo de vida de um agente (docs/capacidades/ciclo-animado.md): o anel (a coluna, no celular), com as voltas
 * por dentro e por fora e Governar como halo, e um cartão por fase: o nome e a pergunta, o que o agente da loja ganha e
 * em que capítulo. Com JS, os cartões saem de baixo do desenho, para o leitor focar nele, e o nó abre o cartão da fase
 * num modal (docs/capacidades/ajustes-da-introducao.md). Os dados vêm de `figuras/ciclo.json`; os capítulos, do
 * `sumario.json`. Abrir um cartão não é ação do leitor (docs/RITMO.md). Sem JS, no modo direto e na impressão, os
 * cartões ficam embaixo (são <details>); no modo direto e na impressão, abrem todos.
 * Com as cenas e a aposta, o desenho vira a animação (ciclo/FiguraCiclo.tsx), que o leitor avança cena a cena; sem JS e
 * na impressão, fica o desenho parado.
 */
import { X } from "lucide-react";
import Anel, { ESTILO } from "./ciclo/Anel";
import FiguraCiclo from "./ciclo/FiguraCiclo";
import type { Entrada } from "./ciclo/cenas";

type Fase = { id: string; nome: string; capitulos: number[]; pergunta: string; ganha: string; nas_fontes: string; transversal?: boolean };
type Ciclo = { fases: Fase[]; fontes: { nome: string; titulo: string; url: string }[] };
interface Props { ciclo: Ciclo; sumario: { capitulos: { numero: number; titulo: string }[] }; numero: string; legenda: string; aqui?: string;
  cenas?: Entrada["cenas"]; aposta?: Entrada["aposta"] }
const { ciclo, sumario, numero, legenda, aqui = "planejar", cenas, aposta } = Astro.props;
const titulo = (n: number) => sumario.capitulos.find((c) => c.numero === n)?.titulo ?? (() => { throw new Error(`MapaDoCiclo: o capítulo ${n} não está no sumário`); })();
const caps = (f: Fase) => f.capitulos.map((n) => `cap. ${n}`).join(" e ");
/* os cartões na ordem do anel: a ida, Evoluir, e Governar por último */
const ordem = [...ciclo.fases.filter((f) => !f.transversal && f.id !== "evoluir"), ...ciclo.fases.filter((f) => f.id === "evoluir"), ...ciclo.fases.filter((f) => f.transversal)];
---
<figure class="mc" id="mapa-do-ciclo" data-mapa-ciclo>
  <div class="mc-quadro">
    <div class="mc-desenho">
      <Anel fases={ciclo.fases} desenho="anel" aceso={aqui} />
      <Anel fases={ciclo.fases} desenho="coluna" aceso={aqui} />
    </div>
    {cenas && aposta && <FiguraCiclo client:visible={{ rootMargin: "400px" }} ciclo={ciclo} cenas={cenas} aposta={aposta} />}
    <p class="mc-dica" hidden>Toque numa fase para ver o que o agente ganha nela.</p>
    <div class="mc-cartoes">
      {ordem.map((f) => (
        <details class="mc-cartao" data-cartao={f.id} id={`fase-${f.id}`} data-aceso={f.id === aqui ? "" : undefined}>
          <summary>
            <span class="mc-c-topo"><b>{f.nome}</b><small>{caps(f)}{f.transversal ? " · vale em todas as fases" : ""}</small></span>
            <span class="mc-c-pergunta">{f.pergunta}</span>
          </summary>
          <div class="mc-c-mais">
            <p><b>O agente da loja ganha:</b> {f.ganha}</p>
            <p class="mc-c-cap">{f.capitulos.length > 1 ? "Capítulos" : "Capítulo"} {f.capitulos.map((n) => titulo(n) === f.nome ? `${n}` : `${n} (${titulo(n)})`).join(" e ")}</p>
            <p class="mc-c-fontes">Nas referências: {f.nas_fontes}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
  <dialog class="mc-modal" aria-labelledby={`mc-modal-titulo-${numero}`}>
    <button type="button" class="mc-modal-fechar" aria-label="Fechar"><X size={18} /></button>
    <h3 id={`mc-modal-titulo-${numero}`} class="mc-modal-titulo"></h3>
    <div class="mc-modal-corpo"></div>
  </dialog>
  <figcaption><b>Figura {numero}</b> · {legenda} Referências: {ciclo.fontes.map((r, i) => <>{i ? ", " : ""}<a href={r.url} target="_blank" rel="noopener">{r.nome}</a></>)}.</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-mapa-ciclo]").forEach((fig) => {
    const cartoes = [...fig.querySelectorAll<HTMLDetailsElement>("details[data-cartao]")];
    const nos = [...fig.querySelectorAll<SVGGElement>("[data-no]")];
    const modal = fig.querySelector<HTMLDialogElement>("dialog.mc-modal")!;
    const direto = () => document.documentElement.hasAttribute("data-direto");
    let emLote = false;
    /* com JS, os cartões saem de baixo do desenho e o nó abre o da fase num modal; no modo direto, ficam embaixo */
    const usarModal = (sim: boolean) => { fig.toggleAttribute("data-modal", sim); fig.querySelector<HTMLElement>(".mc-dica")!.hidden = !sim; };
    usarModal(!direto());
    /* o modal mostra o cartão da fase: o nome e o capítulo no título; a pergunta e o resto embaixo */
    const mostrar = (id: string) => {
      const c = cartoes.find((x) => x.dataset.cartao === id);
      if (!c) return;
      modal.querySelector(".mc-modal-titulo")!.replaceChildren(...[...c.querySelector(".mc-c-topo")!.childNodes].map((n) => n.cloneNode(true)));
      modal.querySelector(".mc-modal-corpo")!.replaceChildren(c.querySelector(".mc-c-pergunta")!.cloneNode(true), ...[...c.querySelector(".mc-c-mais")!.children].map((n) => n.cloneNode(true)));
      if (!modal.open) modal.showModal();
    };
    modal.querySelector(".mc-modal-fechar")!.addEventListener("click", () => modal.close());
    /* tocar fora do cartão fecha: o clique no fundo chega ao próprio <dialog>, mas o do espaço de dentro também */
    modal.addEventListener("click", (e) => {
      const r = modal.getBoundingClientRect();
      if (e.target === modal && (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom)) modal.close();
    });
    /* o nó e o cartão de uma fase acendem juntos; clicar no nó abre o cartão (no modal, ou embaixo no modo direto) */
    const acender = (id: string, abrir: boolean) => {
      nos.forEach((n) => { const sim = n.dataset.no === id; n.classList.toggle("an-aceso", sim); n.setAttribute("aria-pressed", String(sim)); });
      cartoes.forEach((c) => { const sim = c.dataset.cartao === id; c.toggleAttribute("data-aceso", sim); if (sim && abrir && !fig.hasAttribute("data-modal")) c.open = true; });
      if (abrir && fig.hasAttribute("data-modal")) mostrar(id);
    };
    nos.forEach((n) => {
      n.addEventListener("click", () => acender(n.dataset.no!, true));
      n.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); acender(n.dataset.no!, true); } });
    });
    cartoes.forEach((c) => c.addEventListener("toggle", () => { if (c.open && !emLote) acender(c.dataset.cartao!, false); }));
    /* a animação avisa por onde o problema passa (e qual nó do vídeo foi clicado) */
    fig.addEventListener("ciclo:fase", (e) => { const { id, abrir } = (e as CustomEvent<{ id: string; abrir: boolean }>).detail; acender(id, abrir); });
    /* no modo direto e na impressão, todos abertos */
    const todos = (sim: boolean) => { emLote = true; cartoes.forEach((c) => { c.open = sim; }); setTimeout(() => { emLote = false; }); };
    if (direto()) todos(true);
    addEventListener("fontmar:direto", (e) => { const sim = (e as CustomEvent<boolean>).detail; todos(sim); usarModal(!sim); if (sim) modal.close(); });
    addEventListener("beforeprint", () => todos(true));
  });
</script>

<Fragment set:html={`<style>${ESTILO}</style>`} />

<style is:global>
  .mc { margin: 1.8em auto 2em }
  .mc-quadro { border: 1px solid var(--linha); border-radius: 14px; background: var(--nota); padding: 16px; display: grid; gap: 14px; font: 15px/1.5 var(--f-ui) }
  .mc-desenho svg { display: block; width: 100%; height: auto }
  .mc-desenho .an-coluna { display: none }

  /* os cartões */
  .mc-cartoes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px }
  .mc-cartao { border: 1px solid var(--linha); border-radius: 10px; background: var(--papel); padding: 8px 12px }
  .mc-cartao[data-aceso] { border-color: var(--acento); box-shadow: inset 0 0 0 1px var(--acento) }
  .mc-cartao summary { cursor: pointer; list-style: none; display: grid; gap: 2px }
  .mc-cartao summary::-webkit-details-marker { display: none }
  .mc-c-topo { display: flex; gap: 8px; align-items: baseline }
  .mc-c-topo b { font-weight: 600 }
  .mc-c-topo small { font: 12px var(--f-mono); color: var(--ink-2) }
  .mc-c-topo::after { content: "+"; margin-left: auto; color: var(--ink-2) }
  .mc-cartao[open] .mc-c-topo::after { content: "−" }
  .mc-c-pergunta { font: italic 15.5px/1.4 var(--f-texto) }
  .mc-c-mais p { margin: 6px 0 0; font-size: 14px }
  .mc-c-cap, .mc-c-fontes { color: var(--ink-2) }
  .mc-c-fontes { font-size: 13px !important }
  /* com JS, os cartões no modal; embaixo, só a dica */
  .mc[data-modal] .mc-cartoes { display: none }
  .mc-dica { margin: -4px 0 0; font: 13.5px var(--f-ui); color: var(--ink-2) }
  .mc-modal { width: min(460px, calc(100vw - 32px)); padding: 18px 20px 16px; border: 1px solid var(--linha); border-radius: 14px; background: var(--papel);
    color: var(--ink); box-shadow: 0 12px 40px rgb(0 0 0 / .2); font: 15px/1.5 var(--f-ui) }
  .mc-modal::backdrop { background: rgb(0 0 0 / .35) }
  .mc-modal-titulo { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; margin: 0 28px 6px 0; font: 600 18px var(--f-ui) }
  .mc-modal-titulo small { font: 12.5px var(--f-mono); color: var(--ink-2); font-weight: 400 }
  .mc-modal-corpo .mc-c-pergunta { display: block; margin-bottom: 8px; font: italic 17px/1.4 var(--f-texto) }
  .mc-modal-corpo p { margin: 8px 0 0; font-size: 14.5px }
  .mc-modal-fechar { position: absolute; top: 10px; right: 10px; display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: 8px;
    background: none; color: var(--ink-2); cursor: pointer }
  .mc-modal-fechar:hover { background: var(--papel-2); color: var(--ink) }
  .mc figcaption { margin-top: 8px; font: 13.5px/1.5 var(--f-ui); color: var(--ink-2) }

  /* a animação: no lugar do desenho parado, quando a ilha carrega; o botão de avançar, discreto, embaixo */
  /* antes de a ilha carregar, 1 px e não display: none: o client:visible só carrega o que chega a aparecer na tela */
  .mc-video { height: 1px; overflow: hidden }
  .mc[data-animado] .mc-video { height: auto; overflow: visible }
  .mc[data-animado] .mc-desenho { display: none }

  @media (max-width: 640px) {
    .mc-quadro { padding: 10px }
    .mc-desenho .an-anel { display: none }
    .mc-desenho .an-coluna { display: block; max-width: 420px; margin: 0 auto }
    .mc-cartoes { grid-template-columns: 1fr }
  }
  /* na impressão, os cartões abertos, mesmo onde o navegador não avisa antes de imprimir */
  @media print { .mc .mc-video, .mc-dica, .mc-modal { display: none !important } .mc[data-modal] .mc-cartoes { display: grid } .mc[data-animado] .mc-desenho { display: block } .mc-cartao { break-inside: avoid } .mc-cartao::details-content { content-visibility: visible; display: block } .mc-c-topo::after { content: none } }
</style>
