---
/**
 * Um passo de construção: um pedaço pequeno do roteiro, com começo e fim à vista.
 * Em cima, o que vai existir no fim do passo e o mapa do projeto (só o que importa, com o que muda aceso).
 * No meio, o que muda em cada arquivo: só as linhas novas e uma de contexto; o resto fica dobrado, e abre por clique.
 * Se o passo tem um passador, o trecho dele entra bloco a bloco no lugar do código corrido.
 * Embaixo, o comando: com aposta, a saída só aparece depois da aposta. No fim, "agora você tem".
 * Tudo vem do roteiro, dos estados e das saídas gravadas (scripts/saidas.py): nada aqui reconstrói código.
 * No build: o trecho existe no roteiro, tem o que mostrar, e não passa de LIMITE linhas novas.
 */
import { codeToHtml } from "shiki";
import Passador from "./Passador.astro";

const LIMITE = 15;   /* docs/capacidades/passo-a-passo.md: cerca de 12 linhas novas por passo; passou disso, o passo se divide */
type Aposta = { pergunta: string; opcoes: string[]; certa: number };
type PassoRoteiro = { acao: string; arquivo?: string; id?: string; nota: string; aposta?: Aposta; onde?: string };
type Estado = { passo: number; arquivo?: string; conteudo?: string; arquivos?: Record<string, string | null>; rodou?: string;
  gerados?: Record<string, string | null>; apagados?: string[]; apagado?: string };
type Saida = { comando: string; saiu_com: number; saida: [string, string][] };
interface Props {
  roteiro: { passos: PassoRoteiro[] };
  estados: Estado[];
  saidas: Record<string, Saida>;
  glossario: { termos: Record<string, unknown> };
  /** os passos do capítulo (livros/<livro>/passos/<n>.json); este passo é o de `id` */
  capitulo: { passos: DefPasso[] };
  id: string;
  passadores?: Record<string, { codigo: string; dados: { arquivo: string; linhas: string; blocos: { linhas: string }[] } }>;
  pasta?: string;
}
/** `ver`: linhas que ficam à vista mesmo dobradas (números do arquivo no fim do passo), por arquivo */
type DefPasso = { id: string; secao: string; titulo: string; de: number; ate: number; objetivo: string; temos: string; passador?: string; ver?: Record<string, number[]>; engano?: string };
const { roteiro, estados, saidas, glossario, capitulo, id, passadores = {}, pasta = "~/atendimento-bemtevi" } = Astro.props;
const indice = capitulo.passos.findIndex((p) => p.id === id);
if (indice < 0) throw new Error(`Passo: "${id}" não está nos passos do capítulo`);
const { secao, titulo, de, ate, objetivo, temos, ver = {} } = capitulo.passos[indice];
const n = indice + 1, total = capitulo.passos.length;
const passador = capitulo.passos[indice].passador ? (passadores[capitulo.passos[indice].passador!] ?? (() => { throw new Error(`Passo ${id}: o passador "${capitulo.passos[indice].passador}" não foi passado`); })()) : undefined;
/* arquivo de dados (perguntas, loja) não conta no limite: é para copiar, não para digitar; mostra só o começo e o que `ver` pedir */
const DADOS = /(\.(jsonl?|md|toml|lock)$|(^|\/)\.[^/]+$)/;   /* e os arquivos de configuração, como .gitignore */
const falhar = (m: string): never => { throw new Error(`Passo ${n} (${id}): ${m}`); };
const anterior = capitulo.passos[indice - 1];
if (anterior && anterior.ate + 1 !== de) falhar(`o passo anterior termina no ${anterior.ate} do roteiro, e este começa no ${de}: nenhum pedaço do caminho pode sumir`);
if (indice === total - 1 && ate !== roteiro.passos.length) falhar(`o último passo termina no ${ate}, e o roteiro tem ${roteiro.passos.length}`);
if (!(1 <= de && de <= ate && ate <= roteiro.passos.length)) falhar(`trecho ${de}-${ate} fora do roteiro (${roteiro.passos.length} passos)`);

/* o projeto antes e depois do trecho */
/* `null` no conteúdo: arquivo longo demais para ler (o uv.lock); aparece no mapa, mas não abre */
const antes: Record<string, string | null> = {}, depois: Record<string, string | null> = {};
const prontos = new Set<string>();
const editados: string[] = [], notas: Record<string, string[]> = {};
const porComando: Record<string, string> = {};   /* arquivo que um comando do passo criou ou mudou: aparece depois da saída dele */
const apagadosAqui: { nome: string; nota: string }[] = [];
const rodadas: { id: string; nota: string; aposta?: Aposta; s: Saida; onde: string }[] = [];
const mexeu = (nome: string, nota?: string) => { if (!editados.includes(nome)) editados.push(nome); if (nota) (notas[nome] ??= []).push(nota); };
for (const e of estados) {
  if (e.passo > ate) break;
  const p = roteiro.passos[e.passo - 1], aqui = e.passo >= de;
  if (e.arquivos) for (const [nome, texto] of Object.entries(e.arquivos)) {
    depois[nome] = texto;
    if (!aqui) { prontos.add(nome); antes[nome] = texto; } else mexeu(nome);
  }
  if (e.arquivos && aqui) (notas[Object.keys(e.arquivos)[0]] ??= []).push(p.nota);
  if (e.arquivo) { depois[e.arquivo] = e.conteudo!; if (!aqui) antes[e.arquivo] = e.conteudo!; else mexeu(e.arquivo, p.nota); }
  for (const [nome, texto] of Object.entries(e.gerados ?? {})) { depois[nome] = texto; if (!aqui) antes[nome] = texto; else { mexeu(nome); porComando[nome] = e.rodou!; } }
  for (const nome of [...(e.apagados ?? []), ...(e.apagado ? [e.apagado] : [])]) {
    delete depois[nome]; delete antes[nome];
    if (aqui) { const i = editados.indexOf(nome); if (i >= 0) editados.splice(i, 1); delete porComando[nome]; apagadosAqui.push({ nome, nota: p.nota }); }
  }
  if (e.rodou && aqui) rodadas.push({ id: e.rodou, nota: p.nota, aposta: p.aposta, onde: p.onde === "acima" ? pasta.replace(/\/[^/]+$/, "") || "~" : pasta,
    s: saidas[e.rodou] ?? falhar(`a saída ${e.rodou} não está no saidas.json`) });
}
if (!editados.length && !rodadas.length) falhar("o trecho não muda nenhum arquivo nem roda nada");

/* as linhas que mudaram, por arquivo: uma comparação de linhas simples (os arquivos do livro são pequenos) */
function mudadas(a: string[], b: string[]): Set<number> {
  const t = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
  for (let i = a.length - 1; i >= 0; i--) for (let j = b.length - 1; j >= 0; j--) t[i][j] = a[i] === b[j] ? t[i + 1][j + 1] + 1 : Math.max(t[i + 1][j], t[i][j + 1]);
  const novas = new Set<number>();
  let i = 0, j = 0;
  while (j < b.length) {
    if (i < a.length && a[i] === b[j]) { i++; j++; }
    else if (i < a.length && t[i + 1][j] >= t[i][j + 1]) i++;
    else { novas.add(j + 1); j++; }
  }
  return novas;
}
const linhas = (s: string) => s.replace(/\n$/, "").split("\n");
const LINGUA: Record<string, string> = { py: "python", jsonl: "json", json: "json", md: "markdown", toml: "toml" };

type Pedaco = { tipo: "codigo"; html: string } | { tipo: "passador"; codigo: string; dados: NonNullable<Props["passador"]>["dados"] };
const arquivos: { nome: string; novo: boolean; quantas: number; dados: boolean; notas: string[]; pedacos: Pedaco[]; por?: string; grande?: boolean }[] = [];
let totalNovas = 0;
for (const nome of editados) {
  if (depois[nome] === null) { arquivos.push({ nome, novo: !(nome in antes), quantas: 0, dados: true, notas: notas[nome] ?? [], pedacos: [], por: porComando[nome], grande: true }); continue; }
  const b = linhas(depois[nome]!), a = nome in antes && antes[nome] !== null ? linhas(antes[nome]!) : [];
  const novas = mudadas(a, b);
  const quantas = [...novas].filter((k) => b[k - 1].trim()).length;
  const dado = DADOS.test(nome);
  if (!dado) totalNovas += quantas;
  for (const k of ver[nome] ?? []) if (!(k >= 1 && k <= b.length)) falhar(`ver: a linha ${k} não existe em ${nome} (${b.length} linhas)`);
  /* à vista: as linhas novas e uma de cada lado (num arquivo de dados, as três primeiras novas); o resto dobra */
  const vista = new Set<number>(ver[nome] ?? []);
  if (dado) [...novas].sort((x, y) => x - y).slice(0, 3).forEach((k) => vista.add(k));
  else for (const k of novas) for (const d of [-1, 0, 1]) if (k + d >= 1 && k + d <= b.length) vista.add(k + d);
  /* o trecho do passador, achado pelo texto (no arquivo final ele tem outros números de linha) */
  let faixa: [number, number] | null = null, dadosPd: Pedaco | null = null;
  if (passador && passador.dados.arquivo === nome) {
    const [pa, pz] = passador.dados.linhas.split("-").map(Number);
    const alvo = linhas(passador.codigo).slice(pa - 1, pz);
    const k = b.findIndex((_, i) => alvo.every((l, j) => b[i + j] === l));
    if (k < 0) falhar(`o trecho ${passador.dados.linhas} do passador não está em ${nome} no fim do passo`);
    const desloca = k + 1 - pa, mover = (s: string) => s.split("-").map((x) => Number(x) + desloca).join("-");
    faixa = [k + 1, k + alvo.length];
    dadosPd = { tipo: "passador", codigo: depois[nome]!, dados: { ...passador.dados, linhas: mover(passador.dados.linhas), blocos: passador.dados.blocos.map((bl) => ({ ...bl, linhas: mover(bl.linhas) })) } };
  }
  const pedacos: Pedaco[] = [];
  const realcar = async (de_: number, ate_: number) => {
    if (de_ > ate_) return;
    const html = await codeToHtml(b.slice(de_ - 1, ate_).join("\n"), {
      lang: LINGUA[nome.split(".").pop() ?? ""] ?? "text", theme: "dark-plus",
      transformers: [{
        line(no, i) {
          const k = de_ + i - 1;
          no.properties["data-n"] = String(k);
          if (novas.has(k) && b[k - 1].trim()) this.addClassToHast(no, "novo");   /* linha em branco nova não acende: é ruído */
          if (!vista.has(k)) this.addClassToHast(no, "dobrada");
          else if (k > de_ && !vista.has(k - 1)) this.addClassToHast(no, "depois-da-dobra");
        },
        code(no) { no.children = no.children.filter((c) => c.type === "element"); },
      }],
    });
    pedacos.push({ tipo: "codigo", html });
  };
  if (faixa) { await realcar(1, faixa[0] - 1); pedacos.push(dadosPd!); await realcar(faixa[1] + 1, b.length); }
  else await realcar(1, b.length);
  arquivos.push({ nome, novo: !(nome in antes), quantas, dados: dado, notas: notas[nome] ?? [], pedacos, por: porComando[nome] });
}
if (totalNovas > LIMITE) falhar(`${totalNovas} linhas novas; o limite é ${LIMITE}. Divida o passo.`);

/* o mapa: os arquivos do leitor (os prontos ficam num grupo só) */
const doLeitor = Object.keys(depois).filter((k) => !prontos.has(k)).sort();
const nDados = [...prontos].filter((k) => k.startsWith("dados/")).length;
const grupoPronto = [...(nDados ? [`dados/ (${nDados})`] : []), ...[...prontos].filter((k) => !k.startsWith("dados/"))].join(", ");
/* o projeto inteiro no fim do passo, para quem quiser ver o todo (abre por clique; o realce é guardado entre os passos) */
const cache: Map<string, string> = ((globalThis as any).__realcePasso ??= new Map());
const projeto: { nome: string; html: string | null; muda: boolean }[] = [];
for (const nome of Object.keys(depois).sort((a, b) => Number(prontos.has(a)) - Number(prontos.has(b)) || a.localeCompare(b))) {
  const texto = depois[nome];
  let html: string | null = null;
  if (texto !== null) {
    const chave = `${nome}\u0000${texto}`;
    if (!cache.has(chave)) cache.set(chave, await codeToHtml(texto.replace(/\n$/, ""), {
      lang: LINGUA[nome.split(".").pop() ?? ""] ?? "text", theme: "dark-plus",
      transformers: [{ line(no, i) { no.properties["data-n"] = String(i); }, code(no) { no.children = no.children.filter((c) => c.type === "element"); } }],
    }));
    html = cache.get(chave)!;
  }
  projeto.push({ nome, html, muda: editados.includes(nome) });
}
/* o caminho do erro: os trechos que passam por dentro de bibliotecas (ou do -c) dobram; ficam à vista a linha
   "Traceback", os trechos do código do leitor e a mensagem do erro */
type Trecho = { tipo: "linha"; l: string; c: string } | { tipo: "dobra"; linhas: [string, string][] };
function dobrarErro(saida: [string, string][]): Trecho[] {
  const fora: Trecho[] = [];
  let dentro = false, quadro: [string, string][] = [], doLeitor = false;
  const fechar = () => {
    if (!quadro.length) return;
    if (doLeitor) quadro.forEach(([l, c]) => fora.push({ tipo: "linha", l, c }));
    else { const ult = fora.at(-1); if (ult?.tipo === "dobra") ult.linhas.push(...quadro); else fora.push({ tipo: "dobra", linhas: quadro }); }
    quadro = [];
  };
  for (const [l, c] of saida) {
    if (/^Traceback \(most recent call last\):/.test(l)) { dentro = true; fora.push({ tipo: "linha", l, c }); continue; }
    if (dentro && /^  File "/.test(l)) { fechar(); doLeitor = !/\/\.venv\/|"<string>"|\/lib\/python\d/.test(l); quadro.push([l, c]); continue; }
    if (dentro && /^\s/.test(l)) { quadro.push([l, c]); continue; }
    if (dentro) { fechar(); dentro = false; }
    fora.push({ tipo: "linha", l, c });
  }
  fechar();
  return fora;
}
const esc = (s: string) => s.replace(/[&<>"]/g, (x) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[x]!);
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");
---
<section class="passo largo" id={`passo-${id}`} data-passo data-passo-id={id} aria-label={`Passo ${n} de ${total}: ${titulo}`}>
  <header class="ps-topo">
    <div class="ps-linha"><span class="ps-n">passo {n} de {total} · seção {secao}</span><button type="button" class="ps-ver-projeto" data-abrir-projeto>ver o projeto inteiro até aqui</button></div>
    <h3 class="ps-titulo">{titulo}</h3>
    <p class="ps-objetivo"><b>no fim deste passo:</b> <span set:html={md(objetivo)} /></p>
    <div class="ps-mapa" aria-label="O projeto neste passo">
      {doLeitor.map((k) => <span class:list={["ps-arq", { muda: editados.includes(k) }]}>{editados.includes(k) ? "●" : "○"} {k}{arquivos.find((x) => x.nome === k)?.novo && <i> novo</i>}</span>)}
      {apagadosAqui.map((x) => <span class="ps-arq apagado">✕ {x.nome}</span>)}
      {prontos.size > 0 && <span class="ps-arq pronto">já pronto: {grupoPronto}</span>}
    </div>
  </header>

  {arquivos.filter((f) => !f.por).map((f) => (
    <div class="ps-arquivo" data-arquivo>
      <div class="ps-aba"><span class="ps-nome">{f.nome}</span><span class="ps-conta">{f.novo ? (f.dados ? `arquivo novo · ${f.quantas} linhas de dados, para copiar do repositório` : "arquivo novo") : `+${f.quantas} ${f.quantas === 1 ? "linha" : "linhas"}`}</span><button type="button" class="ps-inteiro" data-inteiro>ver o arquivo inteiro</button></div>
      <ol class="ps-notas">{f.notas.map((t) => <li set:html={md(t)} />)}</ol>
      {f.pedacos.map((p) => p.tipo === "codigo"
        ? <div class="ps-codigo" set:html={p.html} />
        : <Passador codigo={p.codigo} dados={p.dados as any} glossario={glossario as any} embutido />)}
    </div>
  ))}

  {rodadas.map((r) => (
    <div class="ps-rodar" data-rodar data-id={r.id} data-certa={r.aposta?.certa}>
      <div class="ps-term">
        <div class="ps-cmd"><span class="ps-prompt">voce@maquina:{r.onde}$</span> {r.s.comando}</div>
        {r.aposta && (
          <div class="ps-aposta">
            <p><b>◆ aposte antes de rodar:</b> {r.aposta.pergunta}</p>
            <div class="ps-opcoes">{r.aposta.opcoes.map((o, j) => <button type="button" data-op={j}>{o}</button>)}</div>
          </div>
        )}
        {!r.aposta && <button type="button" class="ps-btn-rodar" data-rodar-btn>▶ Rodar</button>}
        <pre class="ps-saida" hidden>{dobrarErro(r.s.saida).map((t) => t.tipo === "linha"
          ? <span class={t.c || undefined}>{t.l}{"\n"}</span>
          : <span class="ps-dobra"><button type="button" data-dobra>⋯ {t.linhas.length} linhas do caminho do erro fora do seu código</button><span class="ps-dobrado">{t.linhas.map(([l, c]) => <span class={c || undefined}>{l}{"\n"}</span>)}</span></span>)}</pre>
      </div>
      <p class="ps-nota-run" hidden><span class="ps-veredito"></span> <span set:html={md(r.nota)} /></p>
      {arquivos.some((f) => f.por === r.id) && (
        <div class="ps-depois" hidden>
          <p class="ps-rot-depois">o que o comando criou ou mudou</p>
          {arquivos.filter((f) => f.por === r.id).map((f) => f.grande
            ? <p class="ps-grande"><code>{f.nome}</code> {f.novo ? "nasceu" : "mudou"}: o uv anota aqui as versões exatas de tudo o que instalou. É longo, e quem escreve é o uv, não você.</p>
            : (
            <div class="ps-arquivo" data-arquivo>
              <div class="ps-aba"><span class="ps-nome">{f.nome}</span><span class="ps-conta">{f.novo ? "arquivo novo" : `+${f.quantas} ${f.quantas === 1 ? "linha" : "linhas"}`}</span><button type="button" class="ps-inteiro" data-inteiro>ver o arquivo inteiro</button></div>
              {f.notas.length > 0 && <ol class="ps-notas">{f.notas.map((t) => <li set:html={md(t)} />)}</ol>}
              {f.pedacos.map((p) => p.tipo === "codigo" ? <div class="ps-codigo" set:html={p.html} /> : null)}
            </div>
          ))}
        </div>
      )}
    </div>
  ))}

  {apagadosAqui.length > 0 && <ul class="ps-apagados">{apagadosAqui.map((x) => <li><code>{x.nome}</code> apagado: <span set:html={md(x.nota)} /></li>)}</ul>}

  <p class="ps-temos" data-temos hidden={rodadas.length > 0}>✓ <b>agora você tem:</b> <span set:html={md(temos)} /></p>

  <template data-projeto>
    <div class="pj-topo"><b>o projeto no fim do passo {n}</b> · {titulo}<button type="button" class="pj-fechar" data-fechar aria-label="Fechar">✕</button></div>
    <div class="pj-corpo">
      <nav class="pj-arvore" aria-label="Arquivos">
        {projeto.map((f, i) => <button type="button" data-ver={i} aria-pressed={i === 0 ? "true" : "false"} class:list={[{ muda: f.muda, pronto: prontos.has(f.nome) }]}>{f.nome}</button>)}
      </nav>
      <div class="pj-arquivos">
        {projeto.map((f, i) => (
          <div class="pj-arquivo" data-arq={i} hidden={i > 0}>
            {f.html ? <div class="ps-codigo pj-codigo" set:html={f.html} /> : <p class="pj-grande">{f.nome}: arquivo gerado pelo uv, longo demais para ler aqui.</p>}
          </div>
        ))}
      </div>
    </div>
  </template>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-passo]").forEach((sec) => {
    const direto = () => document.documentElement.hasAttribute("data-direto");
    const runs = [...sec.querySelectorAll<HTMLElement>("[data-rodar]")];
    const fechar = () => { if (runs.every((r) => r.classList.contains("rodou"))) (sec.querySelector("[data-temos]") as HTMLElement).hidden = false; };
    const mostrar = (r: HTMLElement) => {
      r.classList.add("rodou");
      (r.querySelector(".ps-saida") as HTMLElement).hidden = false;
      (r.querySelector(".ps-nota-run") as HTMLElement).hidden = false;
      const depoisDe = r.querySelector<HTMLElement>(".ps-depois"); if (depoisDe) depoisDe.hidden = false;
      r.querySelector<HTMLElement>("[data-rodar-btn]")?.remove();
      fechar();
    };
    runs.forEach((r) => {
      r.querySelector("[data-rodar-btn]")?.addEventListener("click", () => mostrar(r));
      r.querySelectorAll<HTMLButtonElement>("[data-op]").forEach((b) => b.addEventListener("click", () => {
        const certo = b.dataset.op === r.dataset.certa;
        r.querySelectorAll<HTMLButtonElement>("[data-op]").forEach((x) => { x.disabled = true; if (x.dataset.op === r.dataset.certa) x.classList.add("e-a-certa"); if (x === b) x.classList.add("escolhida"); });
        r.querySelector(".ps-veredito")!.textContent = certo ? "Você acertou." : "Não foi dessa vez.";
        r.classList.add(certo ? "certo" : "errado");
        dispatchEvent(new CustomEvent("fontmar:apostou", { detail: r.dataset.id }));   /* o placar só se revela depois da aposta */
        mostrar(r);
      }));
    });
    sec.querySelectorAll<HTMLButtonElement>("[data-dobra]").forEach((b) => b.addEventListener("click", () => b.parentElement!.classList.toggle("aberta")));
    sec.querySelectorAll<HTMLElement>("[data-arquivo]").forEach((f) => f.querySelector("[data-inteiro]")!.addEventListener("click", (e) => {
      const aberto = f.classList.toggle("inteiro");
      (e.currentTarget as HTMLElement).textContent = aberto ? "só o que mudou" : "ver o arquivo inteiro";
    }));
    /* o passo feito avisa a trilha do capítulo */
    const temos = sec.querySelector<HTMLElement>("[data-temos]")!;
    let avisou = false;
    const avisar = () => { if (avisou || temos.hidden) return; avisou = true; dispatchEvent(new CustomEvent("fontmar:passo-feito", { detail: sec.dataset.passoId })); };
    new MutationObserver(avisar).observe(temos, { attributes: true, attributeFilter: ["hidden"] });
    new IntersectionObserver((es, o) => { if (es.some((e) => e.isIntersecting)) { avisar(); if (avisou) o.disconnect(); } }).observe(temos);

    /* o projeto inteiro: num diálogo, montado só quando o leitor pede */
    sec.querySelector("[data-abrir-projeto]")!.addEventListener("click", () => {
      const d = document.createElement("dialog");
      d.className = "pj-dialogo";
      d.append((sec.querySelector("template[data-projeto]") as HTMLTemplateElement).content.cloneNode(true));
      d.querySelectorAll<HTMLButtonElement>("[data-ver]").forEach((b) => b.addEventListener("click", () => {
        d.querySelectorAll<HTMLButtonElement>("[data-ver]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        d.querySelectorAll<HTMLElement>("[data-arq]").forEach((a) => (a.hidden = a.dataset.arq !== b.dataset.ver));
      }));
      d.querySelector("[data-fechar]")!.addEventListener("click", () => d.close());
      d.addEventListener("click", (e) => { if (e.target === d) d.close(); });
      d.addEventListener("close", () => d.remove());
      document.body.append(d); d.showModal();
    });
    const aplicarDireto = () => { if (direto()) runs.forEach(mostrar); };
    addEventListener("fontmar:direto", aplicarDireto); aplicarDireto();
  });
</script>

