---
/**
 * Ação do leitor: separar itens em pilhas antes de saber o nome delas, e só então ver como eles se separam de verdade
 * (docs/RITMO.md: "tem um padrão" pede que o leitor separe antes de ler). Os itens são casos do referencia.jsonl (pelo
 * id, separados pela decisão do contrato) ou cartas escritas, cada uma com a sua pilha (`cartas` e `grupos`). O texto de
 * dentro (o slot) é a explicação, que aparece depois da separação. Duas separações são iguais se juntam os mesmos
 * itens, seja qual for a letra. No modo direto, tudo aparece separado.
 */
import { casos, DECISOES } from "../../lib/referencia.ts";

type Grupo = { nome: string; quando: string };
interface Props { referencia?: string; casos?: string[]; cartas?: { texto: string; pilha: string }[]; grupos?: Record<string, Grupo>;
  pergunta: string; quem?: string }
const { referencia = "", casos: ids, cartas, grupos = DECISOES, pergunta, quem = "contrato" } = Astro.props;
const lista = ids ? casos(referencia, ids, "Pilhas").map((c) => ({ id: c.id, pergunta: c.pergunta, decisao: c.decisao }))
  : (cartas ?? []).map((c, i) => ({ id: `carta ${i + 1}`, pergunta: c.texto, decisao: c.pilha }));
lista.forEach((c) => { if (!grupos[c.decisao]) throw new Error(`Pilhas: "${c.pergunta}" está na pilha "${c.decisao}", que não existe`); });
if (lista.length < 2) throw new Error("Pilhas: precisa de ao menos duas cartas");
const DECISOES_ = grupos;
const decisoes = Object.keys(grupos).filter((d) => lista.some((c) => c.decisao === d));
const dados = { cartas: lista, nomes: grupos };
---
<div class="pil" data-pilhas>
  <p class="pil-rotulo">separe</p>
  <p class="pil-pergunta">{pergunta}</p>
  <div class="pil-cartas">
    {lista.map((c) => (
      <div class="pil-carta" data-decisao={c.decisao}>
        <q>{c.pergunta}</q>
        <div class="pil-letras" role="group" aria-label={`pilha de ${c.id}`}>
          {["A", "B", "C", "D"].map((p) => <button type="button" data-p={p} aria-pressed="false" aria-label={`pilha ${p}`}>{p}</button>)}
        </div>
        <span class="pil-contrato">{quem}: {DECISOES_[c.decisao].nome}</span>
      </div>
    ))}
  </div>
  <p class="pil-acao"><button type="button" data-ver disabled>ver como {quem === "contrato" ? "o contrato separa" : "se separam"}</button></p>
  <div class="pil-revelado" data-revelado hidden>
    <p class="pil-leitura" data-leitura></p>
    <div class="pil-grupos">
      {decisoes.map((d) => (
        <div class="pil-grupo"><b>{DECISOES_[d].nome}</b><span>{DECISOES_[d].quando}</span>
          <small>{lista.filter((c) => c.decisao === d).length} {lista.filter((c) => c.decisao === d).length === 1 ? "item" : "itens"}</small></div>
      ))}
    </div>
    <div class="pil-explica"><slot /></div>
  </div>
  <script type="application/json" data-dados set:html={JSON.stringify(dados).replace(/</g, "\\u003c")} />
</div>

<script>
  type Dados = { cartas: { id: string; pergunta: string; decisao: string }[]; nomes: Record<string, { nome: string }> };
  document.querySelectorAll<HTMLElement>("[data-pilhas]").forEach((fig) => {
    const d: Dados = JSON.parse(fig.querySelector("[data-dados]")!.textContent!);
    const cartas = [...fig.querySelectorAll<HTMLElement>(".pil-carta")];
    const escolha: (string | null)[] = cartas.map(() => null);
    const ver = fig.querySelector<HTMLButtonElement>("[data-ver]")!, rev = fig.querySelector<HTMLElement>("[data-revelado]")!;
    cartas.forEach((c, i) => c.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.addEventListener("click", () => {
      if (!rev.hidden) return;
      escolha[i] = b.dataset.p!;
      c.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      ver.disabled = escolha.some((x) => x === null);
    })));
    ver.addEventListener("click", () => {
      const k = d.cartas;
      const curto = (i: number) => `“${k[i].pergunta.split(/[?.]/)[0]}”`;
      const nome = (i: number) => `“${d.nomes[k[i].decisao].nome}”`;
      let juntou: number[] | null = null, separou: number[] | null = null;
      k.forEach((a, i) => k.forEach((b, j) => {
        if (j <= i) return;
        if (!juntou && escolha[i] === escolha[j] && a.decisao !== b.decisao) juntou = [i, j];
        if (!separou && escolha[i] !== escolha[j] && a.decisao === b.decisao) separou = [i, j];
      }));
      const partes: string[] = [];
      if (juntou) partes.push(`Você juntou ${curto(juntou[0])} e ${curto(juntou[1])}; elas se separam: uma vai em ${nome(juntou[0])}, a outra em ${nome(juntou[1])}.`);
      if (separou) partes.push(`Você separou ${curto(separou[0])} de ${curto(separou[1])}; as duas vão em ${nome(separou[0])}.`);
      fig.querySelector("[data-leitura]")!.textContent = partes.length ? partes.join(" ") : "Você separou exatamente assim.";
      rev.hidden = false;
      fig.classList.add("pil-feito");
      ver.disabled = true; ver.textContent = "separado";
    });
  });
</script>

<style is:global>
  .pil { margin: 1.6em auto 1.8em; border: 1px solid var(--linha); border-radius: 12px; background: var(--nota); padding: 16px; font: 15.5px/1.55 var(--f-ui) }
  .pil-rotulo { margin: 0 0 4px; font: 600 11px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--acento) }
  .pil-pergunta { margin: 0 0 12px; font: 600 17px/1.4 var(--f-ui) }
  .pil-cartas { display: grid; gap: 8px }
  .pil-carta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 12px; align-items: center; border: 1px solid var(--linha); border-radius: 10px; background: var(--papel); padding: 9px 12px }
  .pil-carta q { font: italic 15.5px/1.4 var(--f-texto); min-width: 0 }
  .pil-letras { display: flex; gap: 4px }
  .pil-letras button { width: 34px; height: 30px; border-radius: 7px; border: 1px solid var(--linha); background: var(--papel-2); font: 600 13px var(--f-mono); cursor: pointer }
  .pil-letras button[aria-pressed="true"] { color: var(--papel); border-color: transparent; background: var(--ink) }
  .pil-contrato { display: none; grid-column: 1 / -1; font: 600 12.5px var(--f-ui); color: var(--ok) }
  .pil-feito .pil-contrato { display: block }
  .pil-acao { margin: 12px 0 0 }
  .pil-acao button { border: 1px solid var(--acento); background: var(--acento); color: var(--papel); border-radius: 8px; padding: 5px 12px; font: 500 14px var(--f-ui); cursor: pointer }
  .pil-acao button:disabled { opacity: .5; cursor: default }
  .pil-revelado[hidden] { display: none }
  .pil-revelado { margin-top: 14px; display: grid; gap: 10px }
  .pil-leitura { margin: 0; font-weight: 600 }
  .pil-grupos { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px }
  .pil-grupo { border: 1px solid var(--linha); border-radius: 10px; padding: 8px 10px; background: var(--papel) }
  .pil-grupo b { display: block; font-weight: 600 } .pil-grupo span, .pil-grupo small { display: block; font-size: 13px; color: var(--ink-2) }
  .pil-explica { font: 17px/1.7 var(--f-texto) } .pil-explica p { margin: 0 } .pil-explica p + p { margin-top: .8em }
  @media (max-width: 560px) { .pil-carta { grid-template-columns: 1fr } }
  /* modo direto: as pilhas do contrato, sem pedir a separação */
  html[data-direto] .pil-revelado { display: grid !important }
  html[data-direto] .pil-contrato { display: block }
  html[data-direto] .pil-letras, html[data-direto] .pil-acao, html[data-direto] .pil-leitura { display: none }
</style>
