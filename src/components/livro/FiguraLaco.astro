---
/**
 * A figura 1.1 (docs/capacidades/laco-do-agente.md): quem decide o próximo passo, com o leitor no papel de cada jeito de
 * usar um modelo, em três rodadas (laco/QuemDecide.tsx); e, embaixo, a mesma figura em texto, para quem lê sem JS ou com
 * leitor de tela. Sem JS, só a figura em texto, aberta; com JS, a ilha aparece e ela se fecha (a ilha faz as duas
 * coisas); na impressão, abre de novo. Os dados são os "três jeitos" (tres-jeitos.json), as falas da figura (laco.json)
 * e os clientes da loja; a montagem confere as rodadas contra eles (laco/quemDecide.ts).
 */
import QuemDecide from "./laco/QuemDecide";
import { montarRodadas, type Entrada } from "./laco/quemDecide";

interface Props extends Entrada { numero: string; legenda: string }
const { laco, tresJeitos, clientes, numero, legenda } = Astro.props;
/* confere no build o que a ilha vai montar no navegador */
montarRodadas({ laco, tresJeitos, clientes });
---
<figure class="laco" data-laco>
  <QuemDecide client:visible={{ rootMargin: "400px" }} laco={laco} tresJeitos={tresJeitos} clientes={clientes} />
  <figcaption><b>Figura {numero}</b> · {legenda}</figcaption>
  <details class="laco-texto" open>
    <summary>A figura em texto</summary>
    {tresJeitos.modos.map((m) => (
      <section>
        <h4>{m.nome} <span>quem decide: {(m as { quem_decide?: string }).quem_decide}</span></h4>
        {tresJeitos.perguntas.map((p) => (
          <ol data-caminho={`${m.id}/${p.id}`} aria-label={`${m.nome}: ${p.texto}`}>
            {m.passos[p.id].map((s) => (
              <li><b>{s.quem}{s.decide && " (decide)"}:</b> {s.texto}{s.erro && <em> ✗ {s.erro}</em>}{s.certo && <em> ✓ veio dos dados da loja</em>}</li>
            ))}
          </ol>
        ))}
      </section>
    ))}
  </details>
</figure>

<script>
  /* na impressão, a figura em texto aberta */
  addEventListener("beforeprint", () => document.querySelectorAll<HTMLDetailsElement>("details.laco-texto").forEach((d) => { d.open = true; }));
</script>

<style is:global>
  .laco { margin: 1.8em auto 2em }
  .laco figcaption { margin-top: 10px; font: 14px/1.5 var(--f-ui); color: var(--ink-2) }
  .laco figcaption b { color: var(--ink); font-weight: 600 }

  /* a ilha: um cartão, uma rodada por vez */
  .qd { border: 1px solid var(--linha); border-radius: 14px; background: var(--nota); padding: 16px 18px 18px; display: grid; gap: 12px; font: 15px/1.5 var(--f-ui); color: var(--ink); scroll-margin-top: 76px }
  /* antes de a ilha carregar (e sem JS), 1 px e não display: none: o client:visible só carrega o que chega a aparecer na tela */
  .laco:not([data-animado]) .qd { height: 1px; overflow: hidden; padding: 0; border: 0 }
  .qd-cabeca { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap }
  .qd-titulo { font: 700 19px var(--f-ui) }
  .qd-etiqueta { font: 600 10.5px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2) }
  .qd-rodadas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px }
  .qd-rodadas li { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 4px; border-radius: 999px; border: 1px solid var(--linha); color: var(--ink-2); font: 500 13px var(--f-ui) }
  .qd-rodadas li.qd-agora { border-color: var(--acento); color: var(--ink); font-weight: 600 }
  .qd-num { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 999px; background: var(--papel-2); font: 700 11.5px var(--f-ui) }
  .qd-agora .qd-num { background: var(--acento); color: var(--papel) }
  .qd-feita .qd-num { background: var(--ink-2); color: var(--papel) }

  .qd-rodada { display: grid; gap: 10px }
  .qd-intro { margin: 0; font-size: 16px }
  .qd-quem { display: inline-flex; align-items: center; gap: 5px; font: 600 11.5px var(--f-ui); text-transform: uppercase; letter-spacing: .03em; color: var(--ink-2) }
  .qd-msg { display: grid; gap: 2px; padding: 9px 12px; border-radius: 10px; background: var(--papel); border: 1.5px solid var(--linha); font-size: 17px }
  .qd-msg .qd-quem { text-transform: none; letter-spacing: 0; font-size: 12.5px }
  .qd-trancado { display: inline-flex; align-items: center; gap: 6px; width: max-content; max-width: 100%; padding: 4px 10px; border-radius: 999px; border: 1.5px dashed var(--linha); color: var(--ink-2); font-size: 13.5px }
  .qd-seta { opacity: .6 }

  .qd-prever, .qd-decidir { display: grid; gap: 8px; padding: 10px 12px; border-radius: 12px; border: 1.5px solid var(--acento); background: var(--papel) }
  .qd-opcoes { display: flex; flex-wrap: wrap; gap: 6px }
  .qd-opcoes button { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 999px; border: 1.5px solid var(--linha); background: var(--nota); color: var(--ink); font: 500 14.5px var(--f-ui); cursor: pointer }
  .qd-opcoes button:not(:disabled):hover, .qd-opcoes button:focus-visible { border-color: var(--acento) }
  .qd-opcoes button:disabled { cursor: default }
  .qd-opcoes button.qd-certo { border-color: var(--ok); color: var(--ok); font-weight: 600 }
  .qd-opcoes button.qd-erro { border-color: var(--aviso); color: var(--aviso); text-decoration: line-through }
  .qd-opcoes button.qd-apagada { opacity: .5 }

  .qd-digitando { display: inline-flex; align-items: center; gap: 5px; color: var(--ink-2); font-size: 14px }
  .qd-digitando span { animation: qd-pisca 1s infinite both }
  .qd-digitando span:nth-child(3) { animation-delay: .2s } .qd-digitando span:nth-child(4) { animation-delay: .4s }
  @keyframes qd-pisca { 0%, 100% { opacity: .2 } 50% { opacity: 1 } }

  .qd-resposta { display: grid; gap: 3px; padding: 9px 12px; border-radius: 10px; border: 2px solid; font-size: 16px }
  .qd-resposta.qd-certo { border-color: var(--ok); background: color-mix(in srgb, var(--ok) 10%, var(--papel)) }
  .qd-resposta.qd-erro { border-color: var(--aviso); background: color-mix(in srgb, var(--aviso) 10%, var(--papel)) }
  .qd-porque { display: inline-flex; align-items: center; gap: 6px; font: 600 13.5px var(--f-ui) }
  .qd-resposta.qd-certo .qd-porque { color: var(--ok) } .qd-resposta.qd-erro .qd-porque { color: var(--aviso) }
  .qd-marca { flex: none; display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 999px; color: var(--papel) }
  .qd-marca.qd-certo { background: var(--ok) } .qd-marca.qd-erro { background: var(--aviso) }

  .qd-execucao { display: grid; gap: 8px; padding-top: 4px }
  .qd-feito { display: flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 10px; border: 1px solid var(--linha); background: var(--papel); font-size: 14.5px; color: var(--ink-2) }
  .qd-roteiro { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; counter-reset: passo }
  .qd-roteiro li { counter-increment: passo; display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; padding: 6px 10px; border-radius: 8px; border: 1px solid var(--linha); background: var(--papel); font-size: 14.5px; transition: border-color .3s, opacity .3s }
  .qd-roteiro li::before { content: counter(passo) "."; font: 700 13px var(--f-ui); color: var(--ink-2) }
  .qd-roteiro li.qd-certo { border-color: var(--ok) }
  .qd-roteiro li.qd-erro { border-color: var(--aviso); border-width: 2px }
  .qd-roteiro li.qd-apagada { opacity: .45 }
  .qd-roteiro li .qd-marca { margin-left: auto }
  .qd-volta { font: 13.5px var(--f-mono); color: var(--ink-2) }
  .qd-executar, .qd-seguir { justify-self: start; display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px; border-radius: 999px; border: 1.5px solid var(--acento); background: var(--papel); color: var(--ink); font: 600 14.5px var(--f-ui); cursor: pointer }
  .qd-executar:hover, .qd-seguir:hover { background: var(--papel-2) }

  .qd-acao { display: grid; gap: 2px; padding: 7px 12px; border-left: 3px solid var(--acento); background: var(--papel); border-radius: 0 8px 8px 0 }
  .qd-laco { display: grid; gap: 4px; padding: 8px 12px; border-radius: 10px; border: 1.5px dashed var(--acento); font-size: 14px }
  .qd-laco-titulo { font: 600 11.5px var(--f-ui); text-transform: uppercase; letter-spacing: .04em; color: var(--acento) }
  .qd-elos i { font-style: normal; font-weight: 600 }
  .qd-elos i.qd-certo { color: var(--ok) } .qd-elos i.qd-erro { color: var(--aviso) }

  .qd-licao { display: grid; gap: 10px; padding-top: 2px }
  .qd-licao p { margin: 0; font: 600 16px/1.45 var(--f-ui) }

  .qd-fim { gap: 8px }
  .qd-linha { display: grid; grid-template-columns: 8.5em 1fr auto; align-items: center; gap: 4px 12px; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--linha); background: var(--papel) }
  .qd-acertos { display: inline-flex; gap: 10px; font-size: 13px; color: var(--ink-2) }
  .qd-acertos > span { display: inline-flex; align-items: center; gap: 4px }
  .qd-anuncio { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap }

  .qd-entra { animation: qd-entra .35s ease-out both }
  @keyframes qd-entra { from { opacity: 0; transform: translateY(8px) } to { opacity: 1; transform: none } }
  @media (prefers-reduced-motion: reduce) { .qd-entra, .qd-digitando span { animation: none } .qd-roteiro li { transition: none } }

  @media (max-width: 640px) {
    .qd { padding: 12px 12px 14px; gap: 10px }
    .qd-titulo { font-size: 17px }
    .qd-opcoes button { flex: 1 1 100%; justify-content: center }
    .qd-linha { grid-template-columns: 1fr; gap: 2px }
  }

  .laco-texto { margin-top: 8px; font: 14px/1.5 var(--f-ui); color: var(--ink-2) }
  .laco-texto summary { cursor: pointer; width: max-content; color: var(--acento) }
  .laco-texto h4 { margin: 1em 0 .3em; font: 600 14px var(--f-ui); color: var(--ink) }
  .laco-texto h4 span { font-weight: 400; color: var(--ink-2); margin-left: 6px }
  .laco-texto ol { margin: 0 0 .6em; padding-left: 22px }
  .laco-texto em { color: var(--ink) }
  @media print { .qd { display: none } }
</style>
