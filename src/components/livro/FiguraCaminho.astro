---
/**
 * A figura "o que vamos construir" de um experimento de busca nas notas, em vídeo (cerebro/FiguraCaminhoVideo.tsx): o
 * caminho de uma pergunta pelo cérebro, com os números do rastro gravado e as notas da régua, saídas reais do projeto
 * do experimento.
 */
import FiguraCaminhoVideo from "./cerebro/FiguraCaminhoVideo";

type Saida = { comando: string; saida: [string, string][] };
interface Props { saidas: Record<string, Saida>; rastro: string; regua: [string, string] | [string, string, string]; numero: string; legenda: string }
const { saidas, rastro, regua, numero, legenda } = Astro.props;
const linha = (id: string, padrao: RegExp) => saidas[id]?.saida.map(([l]) => l).find((l) => padrao.test(l))
  ?? (() => { throw new Error(`FiguraCaminho: a saída ${id} não tem ${padrao}; rode a gravação do experimento`); })();
const bruto = linha(rastro, /^\{/);
---
<figure class="figura-cerebro largo">
  <FiguraCaminhoVideo client:visible bruto={bruto} comando={saidas[rastro].comando} regua={{ sem: linha(regua[0], /^nota:/), com: linha(regua[1], /^nota:/), ...(regua[2] ? { modelo: linha(regua[2], /^nota:/) } : {}) }} />
  <figcaption><b>Figura {numero}</b> · {legenda}</figcaption>
</figure>
<style>
  figcaption { margin-top: 10px; font: 14px/1.5 var(--f-ui); color: var(--ink-2) }
  figcaption b { color: var(--ink); font-weight: 600 }
</style>
