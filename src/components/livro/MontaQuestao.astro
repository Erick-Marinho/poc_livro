---
/**
 * Monte a sua primeira questão da prova, no 1.5 (docs/capacidades/capitulo-1-dinamicas.md, etapa 1): a ilha
 * questao/MontaQuestao.tsx. As regras saem do contrato.py e as mensagens, com o gabarito, do referencia.jsonl
 * (questao/regras.ts); o build confere que cada mensagem passa nas regras como está no arquivo. Sem JS, a linha do
 * arquivo de cada mensagem. A primeira mensagem é a que o modo direto mostra preenchida.
 */
import MontaQuestao from "./questao/MontaQuestao";
import { conferir, lerRegras, linha } from "./questao/regras.ts";
import { casos as escolher, DECISOES } from "../../lib/referencia.ts";

interface Props { contrato: string; referencia: string; casos: string[]; pergunta: string; nota: string }
const { contrato, referencia, casos, pergunta, nota } = Astro.props;
const regras = lerRegras(contrato);
const todos = referencia.split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
escolher(referencia, casos, "MontaQuestao");
const mensagens = casos.map((id) => todos.find((c) => c.id === id));
for (const m of mensagens) if (conferir(m, regras).length) throw new Error(`MontaQuestao: ${m.id} não passa nas regras do contrato.py`);
const nomes = Object.fromEntries(Object.entries(DECISOES).map(([k, v]) => [k, v.nome]));
---
<figure class="monta-questao" data-monta-questao>
  <MontaQuestao client:visible={{ rootMargin: "400px" }} regras={regras} mensagens={mensagens} nomes={nomes} pergunta={pergunta} />
  <noscript><pre class="mq-linha">{mensagens.map((m) => linha(m)).join("\n")}</pre></noscript>
  <figcaption>{nota}</figcaption>
</figure>

<style is:global>
  .monta-questao { margin: 1.8em auto 2em }
  .monta-questao figcaption { margin-top: 10px; font: 14px/1.5 var(--f-ui); color: var(--ink-2) }
  .mq { border: 1px solid var(--linha); border-radius: 14px; background: var(--nota); padding: 14px 16px; display: grid; gap: 10px; font: 15px/1.5 var(--f-ui) }
  .mq p { margin: 0 }
  .mq-rotulo { font: 600 11px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--acento) }
  .mq-pergunta { font: 600 16.5px/1.4 var(--f-ui) }
  .mq-msg { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; border: 1px solid var(--linha); background: var(--papel); border-radius: 10px; padding: 10px 14px }
  .mq-msg q { font: italic 17px/1.45 var(--f-texto) }
  .mq-outra { border: 0; background: none; padding: 0; cursor: pointer; font: 500 13px var(--f-ui); color: var(--acento); white-space: nowrap }
  .mq-sub { font: 600 12px var(--f-mono); color: var(--ink-2); margin-top: 4px !important }
  .mq-linha { margin: 0; padding: 10px 12px; border-radius: 10px; background: #1e2127; color: #9aa0aa; font: 13px/1.6 var(--f-mono); white-space: pre-wrap; word-break: break-word }
  .mq-linha code { background: none; color: inherit; padding: 0; border: 0; font: inherit }
  .mq-chave { color: #7f8792 }
  .mq-buraco { display: inline-block; min-width: 2.4em; padding: 0 6px; border: 1px dashed #5c6370; border-radius: 5px; text-align: center; color: #5c6370 }
  .mq-agora { border: 1.5px solid #e5b567; color: #e5b567; font-weight: 700; animation: mq-pulsa 1.6s ease-in-out infinite }
  .mq-novo { color: #e6e1d6; background: rgba(229, 181, 103, .22); border-radius: 4px; animation: mq-acende 1.2s ease-out }
  @keyframes mq-pulsa { 50% { box-shadow: 0 0 0 3px rgba(229, 181, 103, .25) } }
  @keyframes mq-acende { from { background: rgba(229, 181, 103, .6) } }
  @media (prefers-reduced-motion: reduce) { .mq-agora, .mq-novo { animation: none } }
  .mq-passo, .mq-fim { display: grid; gap: 8px; border-top: 1px solid var(--linha); padding-top: 10px }
  .mq-q { font: 600 15.5px/1.4 var(--f-ui) }
  .mq-q span { font: 600 11px var(--f-mono); color: var(--acento); margin-right: 6px; text-transform: uppercase; letter-spacing: .06em }
  .mq-opcoes { display: flex; flex-wrap: wrap; gap: 8px }
  .mq-opcoes button, .mq-form > button, .mq-acoes button { border: 1px solid var(--linha); background: var(--papel); border-radius: 999px; padding: 5px 14px; cursor: pointer; font: 500 14px var(--f-ui); color: var(--ink) }
  .mq-opcoes button:hover, .mq-form > button:hover, .mq-acoes button:hover { border-color: var(--acento) }
  .mq-form { display: flex; flex-wrap: wrap; gap: 8px; align-items: center }
  .mq-form input:not([type]) { flex: 1 1 240px; min-width: 0; border: 1px solid var(--linha); border-radius: 8px; background: var(--papel); padding: 7px 10px; font: 15px var(--f-ui); color: var(--ink) }
  .mq-form > button { background: var(--ink); color: var(--papel); border-color: transparent }
  .mq-marca { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--linha); background: var(--papel); border-radius: 999px; padding: 4px 12px; font-size: 14px; cursor: pointer }
  .mq-barra { border-left: 3px solid var(--aviso); padding: 4px 10px } .mq-barra b { color: var(--aviso) }
  .mq-ok b, .mq-igual { color: var(--ok) } .mq-diferente { color: var(--ink-2) }
  .mq-acoes { display: flex; flex-wrap: wrap; gap: 8px }
</style>
