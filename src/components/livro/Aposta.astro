---
/**
 * Ação do leitor: apostar no que acontece com cada item, antes de ver (docs/RITMO.md: "parece, mas não é" pede prever
 * antes, mostrar depois). Um item é um caso do referencia.jsonl (pelo id, em `caso`) ou um texto escrito (`texto`).
 * O que aconteceu vem de um JSON do livro; se é ilustração, a figura diz (`ilustracao`). No modo direto, o que
 * aconteceu aparece sem pedir a aposta.
 */
import { casos } from "../../lib/referencia.ts";

type Mensagem = { caso?: string; texto?: string; opcoes: string[]; fez: number; porque: string };
/** `resultado`: como o que aconteceu é apresentado; `glosas`: explicações opcionais das opções; `fechos`: a frase do fim */
type Dados = { mensagens: Mensagem[]; resultado?: string; glosas?: Record<string, string>; fechos?: { nenhum: string; alguns: string } };
interface Props { referencia?: string; dados: Dados; pergunta: string; ilustracao?: string }
const { referencia = "", dados, pergunta, ilustracao } = Astro.props;
const textos = dados.mensagens.map((m) => m.texto ?? casos(referencia, [m.caso ?? "(sem caso nem texto)"], "Aposta")[0].pergunta);
dados.mensagens.forEach((m) => { if (!m.opcoes[m.fez]) throw new Error(`Aposta: o que aconteceu com "${m.caso ?? m.texto}" não está entre as opções`); });
const resultado = dados.resultado ?? "O agente fez";
const fechos = dados.fechos ?? { nenhum: "Você investiu em outra coisa em todas. Ele fez o que parecia razoável em todas.",
  alguns: "Você acertou o que ele faria em {n} de {total}. Em nenhuma ele fez o certo." };
---
<div class="apo" data-aposta data-nenhum={fechos.nenhum} data-alguns={fechos.alguns}>
  <p class="apo-rotulo">invista</p>
  <p class="apo-pergunta">{pergunta}</p>
  {dados.mensagens.map((m, i) => (
    <div class="apo-msg" data-fez={m.fez}>
      <q>{textos[i]}</q>
      <div class="apo-opcoes">{m.opcoes.map((o, j) => (
        <button class:list={{ "apo-com-glosa": Boolean(dados.glosas?.[o]) }} type="button" data-j={j} aria-pressed="false">
          {o}
          {dados.glosas?.[o] && <small class="apo-glosa" data-fase={o}>{dados.glosas[o]}</small>}
        </button>
      ))}</div>
      <p class="apo-fez" hidden><b>{resultado}: {m.opcoes[m.fez]}.</b> {m.porque}</p>
    </div>
  ))}
  <p class="apo-placar" data-placar hidden></p>
  {ilustracao && <p class="apo-ilustracao">{ilustracao}</p>}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-aposta]").forEach((fig) => {
    const msgs = [...fig.querySelectorAll<HTMLElement>(".apo-msg")];
    const placar = fig.querySelector<HTMLElement>("[data-placar]")!;
    let feitas = 0, iguais = 0;
    msgs.forEach((m) => m.querySelectorAll<HTMLButtonElement>(".apo-opcoes button").forEach((b) => b.addEventListener("click", () => {
      if (m.classList.contains("feita")) return;
      m.classList.add("feita");
      m.querySelectorAll<HTMLButtonElement>(".apo-opcoes button").forEach((x) => { x.disabled = true; });
      b.setAttribute("aria-pressed", "true");
      m.querySelector<HTMLElement>(".apo-fez")!.hidden = false;
      feitas++; if (b.dataset.j === m.dataset.fez) iguais++;
      if (feitas === msgs.length) {
        placar.hidden = false;
        placar.textContent = (iguais === 0 ? fig.dataset.nenhum! : fig.dataset.alguns!).replace("{n}", String(iguais)).replace("{total}", String(msgs.length));
      }
    })));
  });
</script>

<style is:global>
  .apo { margin: 1.6em auto 1.8em; border: 1px solid var(--linha); border-radius: 12px; background: var(--nota); padding: 16px; font: 15.5px/1.55 var(--f-ui) }
  .apo-rotulo { margin: 0 0 4px; font: 600 11px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--acento) }
  .apo-pergunta { margin: 0 0 12px; font: 600 17px/1.4 var(--f-ui) }
  .apo-msg { border: 1px solid var(--linha); border-radius: 10px; background: var(--papel); padding: 11px 13px; margin-bottom: 10px }
  .apo-msg q { display: block; font: italic 16px/1.45 var(--f-texto); margin-bottom: 8px }
  .apo-opcoes { display: flex; flex-wrap: wrap; gap: 6px }
  .apo-opcoes button { border: 1px solid var(--linha); background: var(--papel-2); border-radius: 999px; padding: 4px 12px; cursor: pointer; font: 500 13.5px var(--f-ui) }
  .apo-opcoes button.apo-com-glosa { flex: 1 1 150px; align-items: flex-start; display: flex; flex-direction: column; border-radius: 10px; text-align: left }
  .apo-glosa { color: var(--ink-2); font: 400 11.5px/1.35 var(--f-ui) }
  .apo-opcoes button:not(:disabled):hover { border-color: var(--acento) }
  .apo-opcoes button:disabled { cursor: default; opacity: .6 }
  .apo-opcoes button[aria-pressed="true"] { opacity: 1; border-color: var(--acento); box-shadow: inset 0 0 0 1px var(--acento) }
  .apo-fez { margin: 10px 0 0; padding: 7px 10px; border-left: 3px solid var(--aviso); background: var(--papel-2); border-radius: 0 8px 8px 0; font-size: 14.5px }
  .apo-fez b { color: var(--aviso) }
  .apo-placar { margin: 4px 0 0; font-weight: 500 }
  .apo-ilustracao { margin: 10px 0 0; font-size: 13px; color: var(--ink-2) }
  /* modo direto: o que o agente fez, sem pedir a aposta */
  html[data-direto] .apo-fez { display: block !important }
  html[data-direto] .apo-opcoes { display: none }
</style>
