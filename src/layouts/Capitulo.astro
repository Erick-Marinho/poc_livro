---
import "../styles/livro.css";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Navegacao from "../components/livro/Navegacao.astro";
import type { ItemSumario } from "../components/livro/Navegacao.astro";

type Vizinho = { href: string; rotulo: string };
interface Props { capitulo: CollectionEntry<"capitulos">; secoes: MarkdownHeading[]; anterior?: Vizinho; proximo?: Vizinho; itens: ItemSumario[] }
const { capitulo, secoes, anterior, proximo, itens } = Astro.props;
const c = capitulo.data;
/* texto curto do cabeçalho: `assim` vira código, o resto é escapado */
const esc = (s: string) => s.replace(/[&<>"]/g, (x) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[x]!);
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");
const titulos = secoes.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, texto: h.text.replace(/^(\d+\.\d+)\s*/, "$1 ") }));
const capitulo_ = c.tipo === "capitulo";
const rotulo = capitulo_ ? `Capítulo ${c.numero} · ${c.titulo}` : c.titulo;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- antes de pintar: a aparência escolhida e a pílula recolhida, guardadas no navegador (comandos/Comandos.tsx) -->
    <script is:inline>try{var t=localStorage.getItem("fontmar:tema");if(t)document.documentElement.dataset.theme=t;if(localStorage.getItem("fontmar:pilula")==="circulo")document.documentElement.classList.add("pilula-recolhida");if(localStorage.getItem("fontmar:direto")==="sim")document.documentElement.setAttribute("data-direto","")}catch(e){}</script>
    <title>{c.titulo} · {c.livro}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <Navegacao livro={c.livro} onde={rotulo} itens={itens} secoes={titulos} anterior={anterior} proximo={proximo} emBreve={c.em_breve} />
    <header class="topo"><div class="in"><a class="marca" href="/" aria-label="FontMar, início">Font<span>Mar</span></a><span class="nome"><b>{c.livro}</b> · um livro que roda</span><span class="esp"></span><span id="onde">{rotulo}</span></div><div class="progresso" id="progresso"></div></header>
    <main class="livro">
      <section class="abertura">
        <div class="cap">{capitulo_ ? "Capítulo" : c.livro}</div>
        {capitulo_ && <div class="numero">{c.numero}</div>}
        <h1>{c.titulo}</h1>
        <p class="lide">{c.lide}</p>
        {c.epigrafe && (
          <figure class="epigrafe">
            <blockquote>{c.epigrafe.texto}</blockquote>
            <figcaption>{c.epigrafe.autor}, em <cite>{c.epigrafe.obra}</cite> ({c.epigrafe.ano})</figcaption>
          </figure>
        )}
      </section>
      {capitulo_ && c.neste && c.partida && (
        <div class="neste"><b>neste capítulo</b><ul>{c.neste.map((n) => <li set:html={md(n)} />)}</ul>
          <span class="ponto">{c.partida.texto} Perdeu o fio? <code>git checkout {c.partida.tag}</code></span></div>
      )}
      <div class="corpo"><slot /></div>
      {c.assinatura && (
        <div class="assinatura"><span>{c.assinatura.autores.join(" e ")}</span><span class="quando">{c.assinatura.quando}</span></div>
      )}
      {(anterior || proximo || c.em_breve) && (
        <nav class="proximo" aria-label="Navegação entre capítulos">
          {anterior ? <a href={anterior.href} rel="prev">← {anterior.rotulo}</a> : <span />}
          {proximo ? <a href={proximo.href} rel="next">{proximo.rotulo} →</a> : c.em_breve ? <span class="em-breve">{c.em_breve} · em breve</span> : <span />}
        </nav>
      )}
      {c.aviso && <p class="ponto" style="margin-top:10px">{c.aviso}</p>}
    </main>
    <script define:vars={{ titulos, inicio: rotulo }}>
      const prog = () => {
        const h = document.documentElement, max = h.scrollHeight - h.clientHeight;
        document.getElementById("progresso").style.width = (max > 0 ? h.scrollTop / max * 100 : 0) + "%";
        let atual = inicio;
        for (const t of titulos) { const el = document.getElementById(t.id); if (el && el.getBoundingClientRect().top < 120) atual = t.texto; }
        document.getElementById("onde").textContent = atual;
      };
      addEventListener("scroll", prog, { passive: true }); prog();
    </script>
  </body>
</html>
