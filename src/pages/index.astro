---
import "../styles/livro.css";
import { getCollection } from "astro:content";

const capitulos = (await getCollection("capitulos")).sort((a, b) => (a.data.numero ?? 0) - (b.data.numero ?? 0));   /* o prefácio vem antes do capítulo 1 */
const livros = new Map<string, { titulo: string; caps: typeof capitulos }>();
for (const c of capitulos) {
  const id = c.id.split("/")[0];
  if (!livros.has(id)) livros.set(id, { titulo: c.data.livro, caps: [] });
  livros.get(id)!.caps.push(c);
}
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- antes de pintar: a aparência escolhida e a pílula recolhida, guardadas no navegador (comandos/Comandos.tsx) -->
    <script is:inline>try{var t=localStorage.getItem("fontmar:tema");if(t)document.documentElement.dataset.theme=t;if(localStorage.getItem("fontmar:pilula")==="circulo")document.documentElement.classList.add("pilula-recolhida");if(localStorage.getItem("fontmar:direto")==="sim")document.documentElement.setAttribute("data-direto","");var f=localStorage.getItem("fontmar:fonte");if(f)document.documentElement.dataset.fonte=f;var z=localStorage.getItem("fontmar:tamanho");if(z)document.documentElement.dataset.tamanho=z}catch(e){}</script>
    <title>Livros que Rodam</title>
  </head>
  <body>
    <main class="livro">
      <section class="abertura"><div class="cap">poc</div><h1>Livros que Rodam</h1>
        <p class="lide">Livros técnicos em que o código se monta e o terminal roda no meio do texto.</p></section>
      {[...livros].map(([id, l]) => (
        <section>
          <h2>{l.titulo}</h2>
          <ul>{l.caps.map((c) => <li><a href={`/${id}/${c.id.split("/").pop()}/`}>{c.data.tipo === "capitulo" ? `Capítulo ${c.data.numero} · ${c.data.titulo}` : c.data.titulo}</a></li>)}</ul>
        </section>
      ))}
    </main>
  </body>
</html>
