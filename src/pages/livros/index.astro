---
import "../../styles/livro.css";
import "../../styles/experimentos.css";
import { estante } from "../../lib/vitrine";
import TopoSite from "../../components/TopoSite.astro";

/* um card por livro, montado do que o livro já tem (lib/vitrine.ts): nada aqui é escrito à mão */
const livros = await estante();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>try{var t=localStorage.getItem("fontmar:tema");if(t)document.documentElement.dataset.theme=t;var f=localStorage.getItem("fontmar:fonte");if(f)document.documentElement.dataset.fonte=f;var z=localStorage.getItem("fontmar:tamanho");if(z)document.documentElement.dataset.tamanho=z}catch(e){}</script>
    <title>Livros · FonteMar.ai</title>
    <meta name="description" content="Livros técnicos de engenharia de IA em que o código se monta e o terminal executa no meio do texto." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,700;1,7..72,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
  </head>
  <body>
    <TopoSite atual="livros" nome="Livros" />
    <main class="livro">
      <section class="vitrine-topo">
        <h1>Livros</h1>
        <p>O aprofundamento: um projeto real construído do começo ao fim, capítulo a capítulo.</p>
      </section>
      <ul class="livros">
        {livros.map((l) => (
          <li>
            <a class="card-livro" href={l.href}>
              <div class="capa" aria-hidden="true">{l.titulo}</div>
              <div class="sobre">
                <span class="estado">{l.escritos < l.planejados ? "em andamento" : "completo"}</span>
                <h2>{l.titulo}</h2>
                <p class="lide">{l.lide}</p>
                {l.autores.length > 0 && <p class="autores">{l.autores.join(" e ")}</p>}
                <span class="progresso-livro">
                  <span class="barra"><span style={`width: ${(100 * l.escritos) / l.planejados}%`} /></span>
                  {l.escritos} de {l.planejados} capítulos escritos
                </span>
                <span class="comecar">Começar pelo {l.comeca.toLowerCase()} →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
