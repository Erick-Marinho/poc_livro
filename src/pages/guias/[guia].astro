---
import { getCollection, render } from "astro:content";
import Guia from "../../layouts/Guia.astro";

/** Um guia por página, em /guias/<guia>/: o nome da pasta do guia é o endereço. */
export async function getStaticPaths() {
  return (await getCollection("guias")).map((guia) => ({ params: { guia: guia.id }, props: { guia } }));
}
const { guia } = Astro.props;
const { Content } = await render(guia);
---
<Guia {...guia.data}><Content /></Guia>
