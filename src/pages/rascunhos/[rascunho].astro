---
/**
 * O que ainda mora em rascunhos/, para ver no `astro dev` antes de virar página (docs/capacidades/experimento-kv-cache.md,
 * etapas 5 e 6). Só existe no desenvolvimento: no build, a rota não gera página nenhuma.
 */
import "../../styles/livro.css";
import "../../styles/experimentos.css";
import KvCache from "../../components/livro/KvCache.astro";
import kv from "../../../rascunhos/kv-cache/figuras/kv.json";
import IdeCapitulo from "../../components/livro/IdeCapitulo.astro";
import roteiro from "../../../rascunhos/kv-cache/roteiros/01.json";
import estados from "../../../rascunhos/kv-cache/roteiros/01.estados.json";
import saidas from "../../../rascunhos/kv-cache/saidas.json";
import passos from "../../../rascunhos/kv-cache/passos/01.json";
import glossario from "../../../rascunhos/kv-cache/glossario.json";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { rascunho: "kv-cache" } }] : [];
}
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>try{var t=localStorage.getItem("fontmar:tema");if(t)document.documentElement.dataset.theme=t;if(localStorage.getItem("fontmar:direto")==="sim")document.documentElement.setAttribute("data-direto","")}catch(e){}</script>
    <title>Rascunho · o KV cache</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <main class="livro">
      <h2>Os quatro caches (rascunho)</h2>
      <KvCache dados={kv} qual="caches" />
      <h2>O que vamos construir (rascunho)</h2>
      <KvCache dados={kv} qual="anotacoes" />
      <h2>A construção na IDE (rascunho)</h2>
      <IdeCapitulo roteiro={roteiro} estados={estados} saidas={saidas} capitulo={passos} glossario={glossario}
        secoes={{ "1": "O laço", "2": "O modelo", "3": "O placar", "4": "O conserto" }} numero="1"
        legenda="O laço construído desde a pasta vazia. Os comandos são executados no projeto real; a coleta foi gravada com o modelo de verdade numa máquina identificada. As mensagens do chat são um roteiro, não um modelo ao vivo." />
    </main>
  </body>
</html>
