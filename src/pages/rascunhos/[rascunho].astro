---
/**
 * O que ainda mora em rascunhos/, para ver no `astro dev` antes de virar página (docs/capacidades/experimento-pausa-e-fluxo.md,
 * etapa 5). Só existe no desenvolvimento: no build, a rota não gera página nenhuma.
 */
import "../../styles/livro.css";
import "../../styles/experimentos.css";
import PausaEFluxo from "../../components/livro/PausaEFluxo.astro";
import IdeCapitulo from "../../components/livro/IdeCapitulo.astro";
import pausa from "../../../rascunhos/pausa-e-fluxo/figuras/pausa.json";
import roteiro from "../../../rascunhos/pausa-e-fluxo/roteiros/01.json";
import estados from "../../../rascunhos/pausa-e-fluxo/roteiros/01.estados.json";
import saidas from "../../../rascunhos/pausa-e-fluxo/saidas.json";
import passos from "../../../rascunhos/pausa-e-fluxo/passos/01.json";
import glossario from "../../../rascunhos/pausa-e-fluxo/glossario.json";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { rascunho: "pausa-e-fluxo" } }] : [];
}
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>try{var t=localStorage.getItem("fontmar:tema");if(t)document.documentElement.dataset.theme=t;if(localStorage.getItem("fontmar:direto")==="sim")document.documentElement.setAttribute("data-direto","")}catch(e){}</script>
    <title>Rascunho · a pausa e o fluxo</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <main class="livro">
      <h2>O que vamos construir (rascunho)</h2>
      <PausaEFluxo dados={pausa} />
      <h2>A construção na IDE (rascunho)</h2>
      <IdeCapitulo roteiro={roteiro} estados={estados} saidas={saidas} capitulo={passos} glossario={glossario}
        secoes={{ "1": "As mensagens", "2": "O medidor", "3": "A coleta", "4": "O conserto" }} numero="2"
        legenda="O medidor construído desde a pasta vazia. Os comandos são executados no projeto real; as duas coletas foram gravadas numa máquina identificada, com o código de cada momento. As mensagens do chat são um roteiro, não um modelo ao vivo." />
    </main>
  </body>
</html>
