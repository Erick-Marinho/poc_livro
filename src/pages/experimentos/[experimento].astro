---
import { existsSync } from "node:fs";
import { getCollection, render } from "astro:content";
import Experimento from "../../layouts/Experimento.astro";
import { experimentos as listar } from "../../lib/vitrine";
import { resultadosDo, type Saidas } from "../../lib/resultados";

/** Um experimento por página, em /experimentos/<experimento>/: o nome da pasta do experimento é o endereço. */
export async function getStaticPaths() {
  /* as saídas gravadas (o resultado do molde sai delas, em lib/resultados.ts); o glob fica aqui dentro porque o
     getStaticPaths do Astro não enxerga variáveis de fora dele */
  const todasSaidas = import.meta.glob<Saidas>("../../../experimentos/*/saidas.json", { eager: true, import: "default" });
  return (await getCollection("experimentos")).map((experimento) => {
    const { id, data } = experimento;
    const saidas = Object.entries(todasSaidas).find(([p]) => p.includes(`/experimentos/${id}/`))?.[1] ?? {};
    const resultados = resultadosDo(id, data.resultado, saidas);
    if (!existsSync(`experimentos/${id}/${data.regua.arquivo}`)) throw new Error(`experimentos/${id}: a régua aponta ${data.regua.arquivo}, que não existe`);
    return { params: { experimento: id }, props: { experimento, resultados } };
  });
}
const { experimento, resultados } = Astro.props;
const { Content, headings } = await render(experimento);
/* o sumário: os experimentos, o mais novo em cima, como na vitrine; a pílula anda nessa ordem */
const todos = await listar();
const i = todos.findIndex((x) => x.id === experimento.id);
const itens = todos.map((x) => ({ titulo: x.titulo, href: x.href, atual: x.id === experimento.id }));
const vizinho = (x?: (typeof todos)[number]) => (x ? { href: x.href, rotulo: x.titulo } : undefined);
---
<Experimento {...experimento.data} baixar={experimento.data.markdown ? `/experimentos/${experimento.id}.md` : undefined} resultados={resultados} secoes={headings} itens={itens} anterior={vizinho(todos[i - 1])} proximo={vizinho(todos[i + 1])}><Content /></Experimento>
